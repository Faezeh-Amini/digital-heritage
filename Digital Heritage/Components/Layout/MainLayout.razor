@inherits LayoutComponentBase
@using Digital_Heritage.Components.Shared
@inject Microsoft.JSInterop.IJSRuntime JS
@inject Digital_Heritage.Data.SiteLanguageService Languages

<div class="page">

    <!-- دکمه خورشیدی انتخاب زبان در تمام صفحات -->
    <SiteLanguagePicker Variant="floating" />

    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>

</div>


@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var stored = await JS.InvokeAsync<string>("siteLanguage.get");
                if (!string.IsNullOrEmpty(stored))
                {
                    Languages.SetLanguage(stored);
                    await JS.InvokeVoidAsync("siteLanguage.apply", stored);
                }
                else
                {
                    await JS.InvokeVoidAsync("siteLanguage.apply", Languages.CurrentLanguage);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("Language init error: " + ex.Message);
            }
        }
    }
}