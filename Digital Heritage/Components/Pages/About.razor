@page "/about"
@using Digital_Heritage.Data
@inject SiteLanguageService Languages
@implements IDisposable

<style>
    .about-me-page {
        max-width: 1240px;
        margin: 0 auto;
        padding: clamp(28px, 5vw, 76px) 24px 80px;
        color: #eee6d8;
        font-family: Arial, sans-serif;
    }

    .about-me-intro {
        max-width: 880px;
        margin: 0 auto 52px;
        text-align: center;
    }

    .about-me-kicker,
    .about-me-number {
        color: #d6b879;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .2em;
    }

    .about-me-intro h1 {
        color: #f6e3b7;
        font: normal clamp(42px, 6vw, 76px) Georgia, serif;
        margin: 18px 0;
    }

    .about-me-intro .about-me-lead {
        font: normal clamp(22px, 2.5vw, 32px)/1.3 Georgia, serif;
        color: #f0d7a5;
    }

    .about-me-intro p {
        font-size: 16px;
        line-height: 1.85;
        color: #cbd2d0;
    }

    .about-me-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 50px;
    }

    .about-me-card {
        background: linear-gradient(145deg, #13232c, #09131b);
        border: 1px solid rgba(214, 184, 121, .35);
        padding: 30px;
        border-radius: 12px;
        min-width: 0;
        transition: transform .25s ease, border-color .25s ease;
    }

        .about-me-card:hover {
            transform: translateY(-4px);
            border-color: #d6b879;
        }

        .about-me-card h2 {
            color: #f4dbac;
            font: normal 26px Georgia, serif;
            margin: 18px 0;
        }

        .about-me-card p {
            color: #c9d0d1;
            font-size: 14px;
            line-height: 1.85;
            margin-bottom: 0;
        }

    /* Bildnachweis link section */

    .about-me-credits {
        max-width: 100%;
        background: linear-gradient(135deg, #172730, #0b161e);
        border: 1px solid rgba(214, 184, 121, .35);
        padding: 35px;
        border-radius: 12px;
        text-align: center;
    }

        .about-me-credits h2 {
            color: #f4dbac;
            font: normal 30px Georgia, serif;
            margin-bottom: 18px;
        }

        .about-me-credits p {
            color: #c9d0d1;
            font-size: 15px;
            line-height: 1.9;
            max-width: 800px;
            margin: 0 auto 25px;
        }

    .about-me-credits-link {
        display: inline-block;
        padding: 13px 25px;
        border: 1px solid #d6b879;
        border-radius: 8px;
        color: #f4dbac;
        text-decoration: none;
        font-weight: 600;
        transition: background .25s ease, color .25s ease;
    }

        .about-me-credits-link:hover,
        .about-me-credits-link:focus-visible {
            background: #d6b879;
            color: #09131b;
        }

    @@media (max-width: 800px) {
        .about-me-grid {
            grid-template-columns: 1fr;
        }

        .about-me-card {
            padding: 24px;
        }

        .about-me-credits {
            padding: 25px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .about-me-card,
        .about-me-credits-link {
            transition: none;
        }

            .about-me-card:hover {
                transform: none;
            }
    }
</style>

<main class="about-me-page">

    <!-- INTRODUCTION -->

    <section class="about-me-intro">

        <span class="about-me-kicker">
            DIGITAL HERITAGE · KURDISTAN
        </span>

        <h1>
            @Label(
                "About me",
                "Über mich",
                "دەربارەی من")
        </h1>

        <p class="about-me-lead">
            @Label(
                "Preserving cultural heritage through digital experiences.",
                "Kulturelles Erbe bewahren. Digital erlebbar machen.",
                "پاراستنی کەلەپووری کولتووری لە ڕێگەی ئەزموونی دیجیتاڵییەوە.")
        </p>

        <p>
            @Label(
                "I created Digital Heritage – Kurdistan Cultural Atlas to make the diversity of Kurdish cultural heritage visible, accessible and discoverable in an interactive way. The project brings together places, traditions, craftsmanship, music and cultural narratives in one digital space.",

                "Mit Digital Heritage – Kurdistan Cultural Atlas möchte ich die Vielfalt des kurdischen Kulturerbes sichtbar, zugänglich und interaktiv erlebbar machen. Das Projekt verbindet Orte, Traditionen, Handwerkskunst, Musik und kulturelle Erzählungen in einem digitalen Raum.",

                "پڕۆژەی Digital Heritage – Kurdistan Cultural Atlas دروست کراوە بۆ ئەوەی جۆراوجۆری کەلەپووری کولتووری کوردی بە شێوەیەکی بینراو، دەستڕاگەیشتوو و کارلێکەر پیشان بدرێت. ئەم پڕۆژەیە شوێن، نەریت، پیشەسازی دەستی، مۆسیقا و چیرۆکە کولتوورییەکان کۆدەکاتەوە.")
        </p>

    </section>

    <!-- INFORMATION CARDS -->

    <div class="about-me-grid">

        <!-- CARD 01: VISION -->

        <section class="about-me-card">

            <span class="about-me-number">
                01 / VISION
            </span>

            <h2>
                @Label(
                    "Why this project?",
                    "Warum dieses Projekt?",
                    "بۆچی ئەم پڕۆژەیە؟")
            </h2>

            <p>
                @Label(
                    "Cultural heritage is more than a collection of historical facts. It lives in languages, memories, everyday practices and the stories people share. My aim is to create a thoughtful digital entry point to this richness, without reducing it to a single narrative.",

                    "Kulturelles Erbe besteht aus mehr als historischen Fakten. Es lebt in Sprachen, Erinnerungen, Alltagspraktiken und den Geschichten der Menschen. Mein Ziel ist es, einen sorgfältig gestalteten digitalen Zugang zu dieser Vielfalt zu schaffen – ohne sie auf eine einzige Erzählung zu reduzieren.",

                    "کەلەپووری کولتووری تەنها زانیاریی مێژوویی نییە؛ لە زمان، بیرەوەری، ژیانی ڕۆژانە و چیرۆکەکانی خەڵکدا دەژی. ئامانجم دروستکردنی دەروازەیەکی دیجیتاڵییە بۆ ئەم جۆراوجۆرییە.")
            </p>

        </section>

        <!-- CARD 02: DESIGN AND TECHNOLOGY -->

        <section class="about-me-card">

            <span class="about-me-number">
                02 / APPROACH
            </span>

            <h2>
                @Label(
                    "Design and technology",
                    "Gestaltung & Technologie",
                    "دیزاین و تەکنەلۆژیا")
            </h2>

            <p>
                @Label(
                    "The atlas combines interactive navigation, visual storytelling and structured cultural information. With Blazor and .NET, I develop a multilingual and responsive digital experience that makes exploration intuitive and accessible across devices.",

                    "Der Atlas verbindet interaktive Navigation, visuelles Storytelling und strukturierte Kulturinformationen. Mit Blazor und .NET entwickle ich eine mehrsprachige und responsive digitale Erfahrung, die das Entdecken intuitiv und auf unterschiedlichen Geräten zugänglich macht.",

                    "ئەتڵەسەکە گەڕانی کارلێکەر، گێڕانەوەی بینراو و زانیاریی کولتووریی ڕێکخراو پێکەوە دەبەستێت. بە Blazor و .NET ئەزموونێکی دیجیتاڵیی فرەزمان و گونجاو بۆ ئامێرە جیاوازەکان دروست دەکەم.")
            </p>

        </section>

        <!-- CARD 03: FUTURE -->

        <section class="about-me-card">

            <span class="about-me-number">
                03 / FUTURE
            </span>

            <h2>
                @Label(
                    "Looking ahead",
                    "Blick in die Zukunft",
                    "ڕوانین بۆ داهاتوو")
            </h2>

            <p>
                @Label(
                    "Digital Heritage is designed as an evolving cultural atlas. I plan to expand it with further regions, stories and multimedia content. Responsible cultural representation and transparent documentation of sources are important parts of this process.",

                    "Digital Heritage ist als kontinuierlich erweiterbarer Kulturatlas konzipiert. Ich möchte ihn um weitere Regionen, Geschichten und multimediale Inhalte ergänzen. Eine verantwortungsvolle kulturelle Darstellung und die transparente Dokumentation von Quellen sind dabei zentrale Anliegen.",

                    "Digital Heritage وەک ئەتڵەسێکی کولتووریی بەردەوام لە گەشەکردن داڕێژراوە. دەمەوێت بە ناوچە، چیرۆک و ناوەڕۆکی فرەڕەهەندیی زیاتر فراوانی بکەم. ڕێزگرتن لە کلتوور و تۆمارکردنی ڕوونی سەرچاوەکان بەشێکی گرنگی ئەم کارەن.")
            </p>

        </section>

    </div>

    <!-- IMAGE CREDITS: LINK ONLY -->

    <section class="about-me-credits"
             aria-labelledby="about-credits-title">

        <h2 id="about-credits-title">
            @Label(
                "Image credits & licences",
                "Bildnachweis & Lizenzen",
                "سەرچاوەی وێنەکان و مۆڵەتەکان")
        </h2>

        <p>
            @Label(
                "Image sources, authors and licence information are documented on a separate page. Copyright information is reviewed where possible, and usage rights that have not been verified are identified as unresolved.",

                "Bildquellen, Urheber und Lizenzinformationen werden auf einer eigenen Seite dokumentiert. Urheberrechtsangaben werden nach Möglichkeit überprüft; ungeklärte Nutzungsrechte werden als nicht verifiziert gekennzeichnet.",

                "سەرچاوەی وێنەکان، خاوەن ئەسەرەکان و زانیاریی مۆڵەتەکان لە پەڕەیەکی جیاوازدا تۆمار دەکرێن. مافەکانی بەکارهێنان کە پشتڕاست نەکراونەتەوە وەک نادیار دیاری دەکرێن.")
        </p>

        <a href="/bildnachweis"
           class="about-me-credits-link">

            @Label(
                "View image credits",
                "Zum Bildnachweis",
                "بینینی سەرچاوەی وێنەکان")

        </a>

    </section>

</main>

@code {

    private string Label(string en, string de, string ku) =>
        Languages.CurrentLanguage switch
        {
            "de" => de,
            "ku" => ku,
            _ => en
        };

    protected override void OnInitialized()
    {
        Languages.Changed += HandleLanguageChanged;
    }

    private void HandleLanguageChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Languages.Changed -= HandleLanguageChanged;
    }
}
