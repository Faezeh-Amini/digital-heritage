@inject SiteLanguageService Languages
<section class="cultural-areas">
    <div class="areas-heading"><span>@L("CULTURAL AREAS · EXAMPLES","KULTURRÄUME · BEISPIELE","ناوچە کولتوورییەکان · نموونە")</span><h2>@L("Cultural areas of Kurdistan","Kulturräume Kurdistans","هەرێمە کولتوورییەکانی کوردستان")</h2><p>@L("Explore the local associations through photographs and stories.","Entdecke regionale Bezüge anhand von Bildern und Geschichten.","پەیوەندییە ناوچەییەکان لە ڕێگەی وێنە و چیرۆکەکانەوە ببینە.")</p></div>
    <div class="areas-grid">
        @foreach (var area in Areas)
        {
            var img = Digital_Heritage.Utilities.ImagePathHelper.NormalizePath(area.Image);
            <article class="area-card"><a class="area-image" href="@img" target="_blank" rel="noopener noreferrer"><img src="@img" alt="@area.AltEn" loading="lazy" /></a><div class="area-copy"><h3>@Text(area.NameFa,area.NameDe,area.NameKu)</h3><p class="area-place">@Text(area.PlaceFa,area.PlaceDe,area.PlaceKu)</p><p>@Text(area.FocusFa,area.FocusDe,area.FocusKu)</p><a href="@area.Link">@L("Explore related stories","Passende Geschichten ansehen","چیرۆکە پەیوەندیدارەکان ببینە") ↗</a></div></article>
        }
    </div>
    <p class="areas-note">@L("These are cultural focal areas, not exclusive borders. Traditions overlap and vary between communities.","Dies sind kulturelle Schwerpunkte, keine exklusiven Grenzen. Traditionen überschneiden sich und variieren zwischen Gemeinschaften.","ئەمە ناوەند و نموونە کولتوورییەکانن، نەک سنووری تایبەت؛ نەریتەکان تێکەڵ دەبن و لە کۆمەڵگە جیاوازەکاندا دەگۆڕێن.") <a href="https://whc.unesco.org/en/list/1647">UNESCO · Hawraman/Uramanat ↗</a></p>
</section>
<style>
.cultural-areas{margin:3rem auto;padding:2rem 0;border-top:1px solid #d5b57455}.areas-heading{text-align:center;margin:0 auto 1.5rem}.areas-heading>span{color:#d5b574;font:9px Arial,sans-serif;letter-spacing:.18em}.areas-heading h2{margin:.7rem;color:#f2e2bd;font:400 clamp(1.7rem,3vw,2.5rem) Georgia,serif}.areas-heading p,.area-copy p,.areas-note{color:#c9c5bb;font:13px/1.75 Arial,sans-serif}.areas-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px}.area-card{overflow:hidden;border:1px solid #d5b57444;background:#151914}.area-image{display:block;height:160px;overflow:hidden}.area-image img{width:100%;height:100%;object-fit:cover;transition:transform .3s}.area-image:hover img{transform:scale(1.04)}.area-copy{padding:13px}.area-copy h3{margin:0 0 .4rem;color:#f0d491;font:400 1.1rem Georgia,serif}.area-copy p{min-height:60px;font-size:11px}.area-copy p.area-place{min-height:0;color:#d5b574}.area-copy>a,.areas-note a{color:#e5cc91;text-decoration:none;font:11px Arial,sans-serif}.areas-note{max-width:900px;margin:1.5rem auto 0;text-align:center;font-size:11px}.areas-note a{white-space:nowrap}
@@media(max-width:900px){.areas-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@@media(max-width:520px){.areas-grid{grid-template-columns:1fr}.area-image{height:210px}}
</style>
@code {
    private string Lang => Languages.CurrentLanguage;
    private string L(string en,string de,string ku)=>Lang switch{"de"=>de,"ku"=>ku,_=>en};
    private string Text(string fa,string de,string ku)=>Lang switch{"de"=>de,"ku"=>ku,_=>fa};
    private List<Area> Areas=>new(){
        new("/images/heritage/Hawraman.jpg","/culture/pir-shalyar","Hawraman / Uramanat","Hawraman / Uramanat","هەورامان / ئورامانات","Hawraman · Takht · Paveh","Hawraman · Takht · Paveh","هەورامان · تەخت · پاوە","Pir Shalyar · daf · tanbur · terrace villages · seasonal pastoral life","Pîr Şalyar · Daf · Tanbur · Terrassendörfer · saisonales Hirtenleben","پیر شالیار · دەف · تەنبور · گوندی پلکانی · ژیانی ئاژەڵداریی وەرزی","Hawraman landscape"),
        new("/images/heritage/kemashan.jpg","/crafts","Kermanshah & Kalhur","Kermanshah & Kalhur","کرماشان و کەلهوڕ","Kermanshah · Harsin · Kerend","Kermanshah · Harsin · Kerend","کرماشان · هەرسین · کەرەند","Harsin kilim · Kalhur music · Kermanshah cuisine · metalwork","Harsin-Kilim · Kalhur-Musik · Kermanshah-Küche · Metallhandwerk","گلیمی هەرسین · مۆسیقای کەلهوڕ · خواردنی کرماشان · فلزکاری","Kermanshah"),
        new("/images/heritage/Sanandaj_from_Abidar.jpg","/music","Sanandaj & Marivan","Sanandaj & Marivan","سنە و مەریوان","Sanandaj · Marivan","Sanandaj · Marivan","سنە · مەریوان","daf · Kurdish music · kalana bread · clothing and textiles","Daf · kurdische Musik · Kelane-Brot · Kleidung und Textilien","دەف · مۆسیقای کوردی · نانی کەڵانە · جل‌وبەرگ و پارچەبافی","Sanandaj landscape"),
        new("/images/heritage/Dengbej/Dengbej.jpg","/music","Mahabad / Mukriyan","Mahabad / Mukriyan","مەهاباد / موکریان","Mahabad · Mukriyan","Mahabad · Mukriyan","مەهاباد · موکریان","Sorani music · dance · Kurdish literature and poetry","Sorani-Musik · Tanz · kurdische Literatur und Poesie","مۆسیقای سۆرانی · هەڵپەڕکێ · ئەدەب و شیعری کوردی","Kurdish singer"),
        new("/images/heritage/Erbil_Citadel.jpg","/culture/newroz","Bashur · Southern Kurdistan","Bashur · Südkurdistan","باشوور · باشووری کوردستان","Erbil · Sulaymaniyah · Halabja","Erbil · Sulaymaniyah · Halabja","هەولێر · سلێمانی · هەڵەبجە","Newroz · Sorani clothing · Halabja memory · regional cuisine","Newroz · Sorani-Kleidung · Erinnerung an Halabja · regionale Küche","نەورۆز · جل‌وبەرگی سۆرانی · بیرەوەریی هەڵەبجە · خواردنی ناوخۆیی","Erbil Citadel"),
        new("/images/heritage/kobani.jfif","/culture/kobani","Rojava · Western Kurdistan","Rojava · Westkurdistan","ڕۆژاڤا · ڕۆژاوای کوردستان","Kobanê · northeastern Syria","Kobanê · Nordostsyrien","کۆبانی · باکووری ڕۆژهەڵاتی سووریا","Kobanê · Kurmanji music · dance · oral memory","Kobanê · kurmandschische Musik · Tanz · mündliche Überlieferung","کۆبانی · مۆسیقای کرمانجی · هەڵپەڕکێ · بیرەوەریی زارەکی","Kobanê"),
        new("/images/heritage/Diyarbakir_Surlari.jpg","/culture/dengbej","Bakur · Northern Kurdistan","Bakur · Nordkurdistan","باکوور · باکووری کوردستان","Van · Mardin · Diyarbakır · Hakkari","Van · Mardin · Diyarbakır · Hakkari","وان · ماردین · دیاربەکر · ھەکاری","Dengbêj · Newroz · regional clothing and dance","Dengbêj · Newroz · regionale Kleidung und Tänze","دەنگبێژ · نەورۆز · جل‌وبەرگ و هەڵپەڕکێی ناوچەیی","Diyarbakır city walls"),
        new("/images/heritage/Traditional_Kurdish_Clothing_-_Kurdish_national_costume.jpg","/culture/wedding-fruit","Kurdish communities in Khorasan","Kurdische Gemeinschaften in Chorasan","کۆمەڵگە کوردییەکانی خۆراسان","North Khorasan · Kurmanji communities","Nord-Chorasan · kurmandschsprachige Gemeinschaften","خۆراسانی باکوور · کۆمەڵگە کرمانجییەکان","Kurmanji dengbêj · clothing · wedding traditions","Kurmandschi-Dengbêj · Kleidung · Hochzeitsbräuche","دەنگبێژی کرمانجی · جل‌وبەرگ · نەریتی هاوسەرگیری","Kurdish traditional clothing")
    };
    private sealed record Area(string Image,string Link,string NameFa,string NameDe,string NameKu,string PlaceFa,string PlaceDe,string PlaceKu,string FocusFa,string FocusDe,string FocusKu,string AltEn);
}

