@page "/culture/pir-shalyar"
@inject Digital_Heritage.Data.SiteLanguageService Languages
@implements IDisposable

<PageTitle>@T("title") · Digital Heritage</PageTitle>

<main class="ritual-page">
    <a class="ritual-back" href="/">⌂ @T("back")</a>
    <nav class="ritual-nav" aria-label="@T("navLabel")">
        <a href="/traditions">@T("allRituals")</a>
        <a href="/culture/newroz">@T("newroz")</a>
        <a class="active" href="/culture/pir-shalyar">@T("title")</a>
        <a href="/culture/wedding-fruit">@T("wedding")</a>
        <a href="/culture/pomegranate-festival">@T("festival")</a>
        <a href="/culture/clove-apple">@T("cloveApple")</a>
    </nav>
    <section class="ritual-hero">
        <a class="ritual-cover" href="/images/heritage/Pirshaliyar/pirshaliyar.jfif" target="_blank" rel="noopener noreferrer"><img src="/images/heritage/Pirshaliyar/pirshaliyar.jfif" alt="@T("heroAlt")" /></a>
        <div class="ritual-title"><span>@T("kicker")</span><h1>@T("title")</h1><p>@T("intro")</p></div>
    </section>
    <article class="ritual-story">
        <h2>@T("legendTitle")</h2><p>@T("legend")</p><p class="ritual-note">@T("oralNote")</p>
        <h2>@T("ceremonyTitle")</h2>
        <div class="ritual-grid">
            <section><span>01</span><h3>@T("walnutTitle")</h3><p>@T("walnut")</p></section>
            <section><span>02</span><h3>@T("dafTitle")</h3><p>@T("daf")</p></section>
            <section><span>03</span><h3>@T("mealTitle")</h3><p>@T("meal")</p></section>
        </div>
        <h2>@T("meaningTitle")</h2><p>@T("meaning")</p>
        <p class="ritual-note">@T("variation")</p>
    </article>
    <section class="ritual-video"><h2>@(Lang == "de" ? "Pîr-Şalyar-Zeremonie · Video" : Lang == "ku" ? "ئاهەنگی پیر شالیار · ڤیدیۆ" : "Pîr Shalyar ceremony · video")</h2><video controls preload="metadata" poster="/images/heritage/Pirshaliyar/pirshaliyar.jfif"><source src="/images/heritage/pirshaliyar..mp4" type="video/mp4" /></video></section>
    <section class="ritual-gallery"><h2>@T("galleryTitle")</h2><p>@T("galleryHint")</p>
        <div class="ritual-photos">
            @foreach (var photo in Photos)
            {
                <figure><a href="@photo.Path" target="_blank" rel="noopener noreferrer"><img src="@photo.Path" alt="@T(photo.Alt)" loading="lazy" /></a><figcaption>@T(photo.Caption)</figcaption></figure>
            }
        </div>
    </section>
</main>

<style>
    .ritual-page{max-width:1320px;margin:auto;padding:1rem clamp(1rem,4vw,3.5rem) 4rem;color:#f0ece2}.ritual-back,.ritual-nav a{color:#efd89c;text-decoration:none}.ritual-back{display:inline-block;margin-bottom:1rem;padding:.65rem .9rem;border:1px solid #d5b57455;background:#151914;font:12px Arial,sans-serif}.ritual-nav{display:flex;gap:8px;overflow-x:auto;padding:5px 0 16px}.ritual-nav a{flex:0 0 auto;padding:9px 12px;border:1px solid #d5b57444;background:#151914;font:11px Arial,sans-serif;white-space:nowrap}.ritual-nav a:hover,.ritual-nav a.active{background:#d5b574;color:#151914}.ritual-hero{display:grid;grid-template-columns:1.1fr .9fr;min-height:370px;border:1px solid #d5b57444;background:#151914}.ritual-cover{display:block;min-height:370px;overflow:hidden}.ritual-cover img{width:100%;height:100%;min-height:370px;object-fit:cover}.ritual-title{align-self:center;padding:clamp(1.5rem,4vw,3.5rem)}.ritual-title>span,.ritual-gallery>span{color:#d5b574;font:9px Arial,sans-serif;letter-spacing:.2em}.ritual-title h1{margin:1rem 0;color:#f4e8c5;font:400 clamp(2rem,4.2vw,3.7rem)/1.08 Georgia,serif}.ritual-title p,.ritual-story p,.ritual-grid p,.ritual-gallery>p{color:#d4d0c5;font:14px/1.9 Arial,sans-serif}.ritual-story{max-width:950px;margin:2.5rem auto}.ritual-story h2,.ritual-gallery h2{margin:2rem 0 .75rem;color:#f3e5c2;font:400 clamp(1.5rem,3vw,2.2rem) Georgia,serif}.ritual-story p{margin:.5rem 0 1rem}.ritual-note{padding:1rem 1.2rem;border-left:2px solid #d5b574;background:#ffffff08;color:#efdfb8!important}.ritual-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.ritual-grid section{padding:1.2rem;border:1px solid #d5b57444;background:#151914}.ritual-grid section>span{color:#d5b574;font:11px Arial,sans-serif;letter-spacing:.15em}.ritual-grid h3{color:#f3e5c2;font:400 1.15rem Georgia,serif}.ritual-video{max-width:950px;margin:3rem auto 0}.ritual-video h2{margin:0 0 .8rem;color:#f3e5c2;font:400 clamp(1.5rem,3vw,2.2rem) Georgia,serif}.ritual-video video{display:block;width:100%;max-height:620px;background:#080a08;border:1px solid #d5b57455}.ritual-gallery{margin-top:3rem}.ritual-gallery>p{color:#aaa99f}.ritual-photos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.ritual-photos figure{margin:0;border:1px solid #d5b57444;background:#151914}.ritual-photos a{display:block;height:260px}.ritual-photos img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s}.ritual-photos a:hover img{transform:scale(1.04)}.ritual-photos figcaption{padding:12px;color:#e8d9b5;font:12px/1.6 Arial,sans-serif}
    @@media(max-width:760px){.ritual-hero{grid-template-columns:1fr}.ritual-cover,.ritual-cover img{min-height:270px;height:270px}.ritual-title{padding:1.5rem}.ritual-grid{grid-template-columns:1fr}.ritual-photos{grid-template-columns:repeat(2,minmax(0,1fr))}.ritual-photos a{height:210px}}
    @@media(max-width:480px){.ritual-photos{grid-template-columns:1fr}.ritual-photos a{height:240px}}
</style>

@code {
    private string Lang => Languages.CurrentLanguage;
    private string T(string key) => (Lang, key) switch
    {
        ("de", "title") => "Pîr Şalyar · das Fest von Hawraman", ("de", "kicker") => "LEBENDIGES KURDISCHES KULTURERBE", ("de", "back") => "Startseite", ("de", "navLabel") => "Kurdische Bräuche", ("de", "allRituals") => "Alle Bräuche", ("de", "newroz") => "Newroz", ("de", "wedding") => "Hochzeitsbräuche", ("de", "festival") => "Granatapfelfest", ("de", "cloveApple") => "Nelkenapfel", ("de", "heroAlt") => "Menschen feiern Pîr Şalyar in Hawraman", ("de", "intro") => "Pîr Şalyar ist eine mehrtägige Winterzeremonie in Uraman Takht im Hawraman-Gebiet. Musik, gemeinsames Essen, Besuche und mündliche Überlieferungen verbinden die Menschen mit ihrem kulturellen Erbe.", ("de", "legendTitle") => "Die lokale Überlieferung", ("de", "legend") => "Eine bekannte Erzählung handelt von Schah-Bahar Chatun, der Tochter des Herrschers von Buchara, und ihrer Verbindung mit Pîr Şalyar. Die Geschichte wird in Hawraman in verschiedenen mündlichen Fassungen erzählt und ist Teil des kulturellen Gedächtnisses der Region.", ("de", "oralNote") => "Diese Erzählung ist eine lokale mündliche Überlieferung; sie sollte nicht als gesicherter historischer Bericht gelesen werden.", ("de", "ceremonyTitle") => "Elemente der Zeremonie", ("de", "walnutTitle") => "Walnüsse teilen", ("de", "walnut") => "Das Verteilen von Walnüssen aus dem Garten von Pîr Şalyar gilt als Zeichen des Teilens, der Gastfreundschaft und des gemeinschaftlichen Beginns der Feier.", ("de", "dafTitle") => "Daf und gemeinsamer Gesang", ("de", "daf") => "Daf-Trommeln, religiöse Gesänge und gemeinschaftliche Bewegungen prägen Teile der Zusammenkunft. Ablauf und Ausführung können sich unterscheiden.", ("de", "mealTitle") => "Gemeinsames Essen", ("de", "meal") => "Ein gemeinsames Mahl und das Teilen von Speisen stehen für Fürsorge und Zusammenhalt. Einzelne Bräuche werden je nach Jahr und örtlicher Gemeinschaft unterschiedlich gestaltet.", ("de", "meaningTitle") => "Kulturelle Bedeutung", ("de", "meaning") => "Die Zeremonie verbindet spirituelle Erinnerung, Musik, Gastfreundschaft und das Zusammenkommen der Gemeinschaft. Sie ist ein Beispiel lebendigen immateriellen Kulturerbes in Hawraman.", ("de", "variation") => "Die Beschreibungen von Ablauf und Bedeutung unterscheiden sich zwischen Familien und Quellen. Diese Seite fasst lokale Überlieferungen zusammen und erhebt keinen Anspruch, jede Variante abzubilden.", ("de", "galleryTitle") => "Pîr Şalyar in Bildern", ("de", "galleryHint") => "Bild anklicken, um es in voller Größe zu öffnen.", ("de", "alt1") => "Menschen beim Pîr-Şalyar-Fest", ("de", "alt2") => "Eine Zeremonie in Hawraman", ("de", "alt3") => "Gemeinschaftliche Feier in traditionellem Umfeld", ("de", "alt4") => "Musik und Zusammenkunft beim Fest", ("de", "alt5") => "Pîr-Şalyar-Zeremonie", ("de", "cap1") => "Festversammlung", ("de", "cap2") => "Einblick in die Zeremonie", ("de", "cap3") => "Kulturelle Zusammenkunft", ("de", "cap4") => "Musik und Gemeinschaft", ("de", "cap5") => "Überlieferte Zeremonie",
        ("ku", "title") => "پیر شالیار · جەژنی هەورامان", ("ku", "kicker") => "میراتی زیندووی کولتووریی کوردی", ("ku", "back") => "پەڕەی سەرەکی", ("ku", "navLabel") => "نەریتە کوردییەکان", ("ku", "allRituals") => "هەموو نەریتەکان", ("ku", "newroz") => "نەورۆز", ("ku", "wedding") => "نەریتی هاوسەرگیری", ("ku", "festival") => "جەژنی هەنار", ("ku", "cloveApple") => "سێوی مێخەک‌ڕێژ", ("ku", "heroAlt") => "خەڵک لە هەورامان جەژنی پیر شالیار دەگێڕن", ("ku", "intro") => "پیر شالیار ئاهەنگێکی چەند ڕۆژەی زستانە لە ئورامانی تەخت، لە ناوچەی هەورامانە. مۆسیقا، خواردنی هاوبەش، سەردان و گێڕانەوەی زارەکی خەڵک بە میراتی کولتوورییەوە دەبەستنەوە.", ("ku", "legendTitle") => "گێڕانەوەی ناوخۆیی", ("ku", "legend") => "یەکێک لە گێڕانەوە ناسراوەکان باس لە شاھ‌باھار خاتون، کچی پاشای بوخارا، و پەیوەندیی ئەو بە پیر شالیار دەکات. ئەم چیرۆکە بە چەند شێوەیەکی زارەکی لە هەوراماندا دەگێڕدرێتەوە و بەشێکە لە بیرەوەریی کولتووریی ناوچەکە.", ("ku", "oralNote") => "ئەم چیرۆکە گێڕانەوەیەکی زارەکیی ناوخۆییە؛ نابێت وەک ڕاپۆرتێکی مێژوویی دڵنیابەخش بخوێندرێتەوە.", ("ku", "ceremonyTitle") => "هەندێک بەشی ئاهەنگ", ("ku", "walnutTitle") => "دابەشکردنی گوز", ("ku", "walnut") => "دابەشکردنی گوزی باخی پیر شالیار وەک نیشانەی بەشکردن، میوانداری و دەستپێکی هاوبەشی ئاهەنگ دادەنرێت.", ("ku", "dafTitle") => "دەف و گۆرانیی هاوبەش", ("ku", "daf") => "لێدانی دەف، گۆرانیی ئایینی و جووڵەی هاوبەش بەشێک لە کۆبوونەوەکە پێکدەهێنن. شێوازی بەڕێوەبردن دەتوانێت جیاواز بێت.", ("ku", "mealTitle") => "خواردنی هاوبەش", ("ku", "meal") => "خواردنی هاوبەش و بەشکردنی نان نیشانەی چاودێری و یەکگرتووییە. وردەکاریی نەریتەکان بەپێی ساڵ و کۆمەڵگەی ناوخۆیی دەگۆڕێت.", ("ku", "meaningTitle") => "واتای کولتووری", ("ku", "meaning") => "ئەم ئاهەنگە یادەوەریی ڕۆحانی، مۆسیقا، میوانداری و کۆبوونەوەی کۆمەڵگە پێکەوە دەبەستێتەوە. نموونەیەکە لە میراتی ناماددیی زیندووی هەورامان.", ("ku", "variation") => "گێڕانەوەکان لەسەر شێوازی بەڕێوەبردن و واتا بە پێی خێزان و سەرچاوە جیاوازن. ئەم پەڕەیە هەندێک گێڕانەوەی ناوخۆیی کۆدەکاتەوە و بانگەشەی نوێنەرایەتیی هەموو شێوازەکان ناکات.", ("ku", "galleryTitle") => "پیر شالیار بە وێنە", ("ku", "galleryHint") => "کلیک لە وێنە بکە بۆ کردنەوەی بە قەبارەی تەواو.", ("ku", "alt1") => "خەڵک لە جەژنی پیر شالیار", ("ku", "alt2") => "ئاهەنگێک لە هەورامان", ("ku", "alt3") => "کۆبوونەوەی کولتووری لە ژینگەی نەریتی", ("ku", "alt4") => "مۆسیقا و کۆبوونەوە لە جەژنەکەدا", ("ku", "alt5") => "ئاهەنگی پیر شالیار", ("ku", "cap1") => "کۆبوونەوەی جەژن", ("ku", "cap2") => "دیمەنێک لە ئاهەنگەکە", ("ku", "cap3") => "کۆبوونەوەی کولتووری", ("ku", "cap4") => "مۆسیقا و کۆمەڵگە", ("ku", "cap5") => "ئاهەنگی گێڕدراوە",
        (_, "title") => "پیر شالیار · آیین هورامان", (_, "kicker") => "میراث زندهٔ فرهنگی کردستان", (_, "back") => "صفحهٔ اصلی", (_, "navLabel") => "آیین‌های کردی", (_, "allRituals") => "همهٔ آیین‌ها", (_, "newroz") => "نوروز کردی", (_, "wedding") => "رسم‌های عروسی", (_, "festival") => "جشن انار", (_, "cloveApple") => "سیب میخک‌کوب", (_, "heroAlt") => "مردم در آیین پیر شالیار در هورامان", (_, "intro") => "پیر شالیار آیینی چندروزه در زمستان است که در اورامان تخت برگزار می‌شود. موسیقی، غذای جمعی، دیدارها و روایت‌های شفاهی، مردم را با میراث فرهنگی منطقه پیوند می‌دهند.", (_, "legendTitle") => "روایت محلی", (_, "legend") => "یکی از روایت‌های شناخته‌شده دربارهٔ شاه‌بهار خاتون، دختر پادشاه بخارا، و پیوند او با پیر شالیار است. این داستان با روایت‌های شفاهی گوناگون در هورامان نقل می‌شود و بخشی از حافظهٔ فرهنگی منطقه است.", (_, "oralNote") => "این داستان یک روایت شفاهی محلی است و نباید آن را گزارش تاریخیِ قطعی دانست.", (_, "ceremonyTitle") => "بخش‌هایی از آیین", (_, "walnutTitle") => "تقسیم گردو", (_, "walnut") => "تقسیم گردوهای باغ پیر شالیار را نشانه‌ای از بخشندگی، مهمان‌نوازی و شریک‌شدن مردم در آغاز جشن می‌دانند.", (_, "dafTitle") => "دف و آواز جمعی", (_, "daf") => "دف‌نوازی، آوازهای آیینی و حرکت‌های جمعی بخشی از گردهمایی را شکل می‌دهند. شیوهٔ اجرا ممکن است تفاوت داشته باشد.", (_, "mealTitle") => "غذای جمعی", (_, "meal") => "آماده‌کردن و تقسیم غذا نمادی از همیاری و پیوند اجتماعی است. جزئیات رسم‌ها ممکن است با توجه به سال و جامعهٔ محلی تغییر کند.", (_, "meaningTitle") => "معنای فرهنگی", (_, "meaning") => "این آیین یاد معنوی، موسیقی، مهمان‌نوازی و گردهمایی مردم را به هم پیوند می‌دهد و نمونه‌ای از میراث ناملموس زندهٔ هورامان است.", (_, "variation") => "شرح مراسم و معناهای آن در خانواده‌ها و منابع مختلف تفاوت دارد. این صفحه چند روایت محلی را بازتاب می‌دهد و ادعای پوشش همهٔ شکل‌های آیین را ندارد.", (_, "galleryTitle") => "پیر شالیار در تصاویر", (_, "galleryHint") => "برای دیدن تصویر در اندازهٔ کامل روی آن کلیک کن.", (_, "alt1") => "مردم در جشن پیر شالیار", (_, "alt2") => "آیینی در هورامان", (_, "alt3") => "گردهمایی فرهنگی در فضای سنتی", (_, "alt4") => "موسیقی و گردهمایی در مراسم", (_, "alt5") => "مراسم پیر شالیار", (_, "cap1") => "گردهمایی جشن", (_, "cap2") => "نمایی از مراسم", (_, "cap3") => "گردهمایی فرهنگی", (_, "cap4") => "موسیقی و همبستگی", (_, "cap5") => "آیین و روایت محلی",
        _ => key
    };
    private string OnLanguage => Languages.CurrentLanguage;
    private IReadOnlyList<Photo> Photos => new[] { new Photo("/images/heritage/pirshaliyar1.jfif", "alt1", "cap1"), new Photo("/images/heritage/pirshaliyar2.jfif", "alt2", "cap2"), new Photo("/images/heritage/pirshaliyar3.jfif", "alt3", "cap3"), new Photo("/images/heritage/pirshaliyar4.jfif", "alt4", "cap4"), new Photo("/images/heritage/pirshaliyar5.jfif", "alt5", "cap5") };
    protected override void OnInitialized() => Languages.Changed += OnLanguageChanged;
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Languages.Changed -= OnLanguageChanged;
    private sealed record Photo(string Path, string Alt, string Caption);
}



