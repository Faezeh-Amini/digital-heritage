        ("de", "cap4") => "Nelkenäpfel in unterschiedlichen Formen",
        ("de", "cap5") => "Eine Geschenkpräsentation mit Nelkenapfel",

        ("ku", "title") => "سێوی مێخەک‌ڕێژ",
        ("ku", "kicker") => "میراتی کولتووریی کوردی",
        ("ku", "back") => "بگەڕێوە بۆ پەڕەی سەرەکی",
        ("ku", "heroAlt") => "ژنێک مێخەک لە سێوێکدا دەچێنێت",
        ("ku", "intro") => "سێوی مێخەک‌ڕێژ یادگارێکی دەستکردە کە لە هەندێک کۆمەڵگەی کوردیدا بە خۆشەویستی، دڵتەنگی، دڵسۆزی و بیرەوەرییەوە پەیوەست دەکرێت.",
        ("ku", "paragraph1") => "سێوی مێخەک‌ڕێژ نموونەیەکی جوانە لە کولتووری ماددی و هێمای هەستی لە هەندێک کۆمەڵگەی کوردیدا. شتێکی سادەیە لە سێو و مێخەک پێکهاتووە، بەڵام دەتوانێت چیرۆکی خۆشەویستی، دڵتەنگی، دڵسۆزی و بیرەوەری لەخۆ بگرێت.",
        ("ku", "paragraph2") => "بۆ دروستکردنی، سێوێکی سالم و جوان هەڵدەبژێردرێت و مێخەک بە وردی لە پوستەکەیدا دەچێنرێت. کات و گرنگیدانێک کە بۆ ڕازاندنەوەی دەخرێتەگەڕ بەشێکە لە بەهای دیارییەکە؛ تەنها دەرکەوتنی نییە، بەڵکو هەستی پشت دروستکردنەکەشی گرنگە.",
        ("ku", "paragraph3") => "لە هەندێک گێڕانەوەی زارەکیدا سێوی مێخەک‌ڕێژ دیاریی نێوان دڵداران بووە و دەتوانی نیشانەی خۆشەویستی، دڵتەنگی، چاوەڕوانی یان ئاشتی‌کردنەوە بێت. لەبەر ئەوە وەک زمانێکی بێدەنگی هەستەکان دەبینرێت.",
        ("ku", "paragraph4") => "پاراستن و ماندوویی ئەم شتەش بەشێکە لە واتاکەی. مێخەک دەتوانێت کاریگەری لەسەر وشکبوونەوەی سێو و ماوەی مانەوەی بۆنەکەی هەبێت؛ بەڵام ماوەی پاراستنی وەک یادگار بە شێوازی دروستکردن و هەڵگرتنەوە پەیوەستە.",
        ("ku", "paragraph5") => "ئەمڕۆ جگە لە واتای خۆشەویستی، سێوی مێخەک‌ڕێژ لە هەندێک چالاکیی کولتووری و هونەریدا وەک هێمای یادکردنەوە، ئاشتی و پاراستنی بیرەوەری بەکاردێت. ئەم نەریتە سروشت، کاری دەستی، هەستی مرۆیی و بیرەوەریی کولتووری پێکەوە دەبەستێتەوە.",
        ("ku", "context") => "واتاکان لە گێڕانەوە زارەکییەکانەوە هاتوون و دەتوانن بەپێی ناوچە و خێزان جیاواز بن.",
