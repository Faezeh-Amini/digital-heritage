@page "/"
@using System.Globalization
@inject Digital_Heritage.Data.SiteLanguageService Languages
@implements IDisposable

<PageTitle>@Languages.Text("home.title") · Digital Heritage</PageTitle>

<div class="heritage-home">
    <header class="home-header">
        <a class="home-brand" href="/" aria-label="Digital Heritage home">
            <span class="brand-sun" aria-hidden="true">✺</span>
            <span class="brand-type">DIGITAL HERITAGE<small>KURDISTAN · CULTURAL ATLAS</small></span>
        </a>
        <nav class="home-nav" aria-label="Main navigation">
            <a class="current" href="/">@Languages.Text("nav.home")</a>
            <a href="/map">@Languages.Text("nav.map")</a>
            <a href="/gallery">@Languages.Text("nav.gallery")</a>
            <a href="/culture/newroz">@Languages.Text("nav.stories")</a>
            <a href="/traditions">@((Languages.CurrentLanguage == "de") ? "Bräuche" : Languages.CurrentLanguage == "ku" ? "نەریتەکان" : "Traditions")</a>
            <a href="/culture/kobani">@((Languages.CurrentLanguage == "de") ? "Kobanê" : Languages.CurrentLanguage == "ku" ? "کۆبانی" : "Kobanî")</a>
            <a href="/about">@Languages.Text("nav.about")</a>
        </nav>
        <span class="home-picker-space" aria-hidden="true"></span>
    </header>

    <main>
        <section class="home-hero" aria-labelledby="home-title">
            <div class="hero-canvas">
                <img class="hero-art" src="/images/heritage/home-hero.webp" alt="A Kurdish woman in traditional dress in front of a glowing screen showing twelve cultural topics" />
                @foreach (var tile in Tiles)
                {
                    <a class="hero-hotspot" style="@Pos(tile)" href="@tile.Href" aria-label="@tile.Label" title="@tile.Label"><span class="hotspot-arrow">↗</span><span class="hero-hotspot-label">@tile.Label</span></a>
                }
            </div>
            <div class="hero-overlay" aria-hidden="true"></div>
            <div class="hero-editorial">
                <p class="eyebrow"><span class="eyebrow-line"></span>@Languages.Text("home.welcome")</p>
                <h1 id="home-title">@Languages.Text("home.title")</h1>
                <p class="hero-subtitle">@Languages.Text("home.kicker")<br /><strong>@Languages.Text("home.subtitle")</strong></p>
                <a class="heritage-cta" href="/map"><span>@Languages.Text("home.explore")</span><b>↗</b></a>
            </div>
        </section>

        <section class="home-history" aria-labelledby="home-history-title">
            <div class="history-period"><span>✺</span><strong>@Languages.Text("home.historyPeriod")</strong></div>
            <div class="history-copy"><span class="section-kicker">@Languages.Text("home.history")</span><h2 id="home-history-title">@Languages.Text("home.historyTitle")</h2><p>@Languages.Text("home.historyText")</p><p class="history-today">@Languages.Text("home.today")</p><a href="https://www.cambridge.org/core/books/abs/kurds/from-rebellion-to-political-manifestos-kurdish-nationalism-in-twentiethcentury-iran-and-iraq/F75A900BB2D44EE088AEB5D956183FC6" target="_blank" rel="noopener noreferrer">@Languages.Text("home.historySource") ↗</a></div>
        </section>
    </main>

    <footer class="home-footer"><span>© 2026 DIGITAL HERITAGE · KURDISTAN</span><span>PLACE <b>·</b> VOICE <b>·</b> MEMORY</span><a href="/map">@Languages.Text("nav.map") ↗</a></footer>
</div>

<style>
    .page:has(.heritage-home) {
        min-height: 100vh
    }

        .page:has(.heritage-home) .sidebar {
            display: none
        }

        .page:has(.heritage-home) main {
            min-height: 100vh;
            overflow: visible
        }

        .page:has(.heritage-home) .content {
            padding: 0 !important
        }

    .heritage-home {
        --gold: #d6b879;
        --bright: #eedba9;
        --paper: #f1eee5;
        --muted: #aaa79e;
        --line: rgba(230,211,169,.19);
        min-height: 100vh;
        padding: 0;
        overflow: hidden;
        background: radial-gradient(ellipse at 61% 43%,#20251c 0,#11140f 42%,#090b09 100%);
        color: var(--paper);
        font-family: Georgia,"Times New Roman",serif
    }

    .home-header {
        height: 78px;
        padding: 0 clamp(18px,4.2vw,70px);
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        border-bottom: 1px solid var(--line);
        position: relative;
        z-index: 5;
        font-family: Arial,sans-serif
    }

    .home-brand {
        display: flex;
        align-items: center;
        gap: 13px;
        color: var(--paper);
        text-decoration: none;
        white-space: nowrap
    }

    .brand-sun {
        width: 39px;
        height: 39px;
        display: grid;
        place-items: center;
        border: 1px solid var(--gold);
        border-radius: 50%;
        color: var(--gold);
        font-size: 28px;
        line-height: 1;
        text-shadow: 0 0 14px #d6b87966
    }

    .brand-type {
        font-size: 10px;
        letter-spacing: .19em;
        font-weight: 600
    }

        .brand-type small {
            display: block;
            margin-top: 5px;
            color: #bdb7a7;
            font-size: 7px;
            letter-spacing: .23em;
            font-weight: 400
        }

    .home-nav {
        display: flex;
        align-items: center;
        gap: clamp(15px,2.2vw,34px);
        height: 100%
    }

        .home-nav a {
            height: 100%;
            display: flex;
            align-items: center;
            position: relative;
            color: #d1cbbb;
            text-decoration: none;
            font-size: 8px;
            letter-spacing: .16em;
            text-transform: uppercase;
            white-space: nowrap
        }

            .home-nav a:hover, .home-nav a.current {
                color: var(--bright)
            }

                .home-nav a.current:after {
                    content: "";
                    position: absolute;
                    left: 0;
                    right: 0;
                    bottom: 17px;
                    height: 1px;
                    background: var(--gold)
                }

    .home-languages {
        display: flex;
        gap: 5px
    }

        .home-languages button {
            width: 34px;
            height: 34px;
            padding: 5px;
            border: 0;
            border-radius: 50%;
            background: repeating-conic-gradient(#d6b879 0deg 7deg,transparent 7deg 17deg);
            color: #c8c1af;
            cursor: pointer;
            filter: drop-shadow(0 1px 4px #0008)
        }

            .home-languages button span {
                width: 24px;
                height: 24px;
                display: grid;
                place-items: center;
                border: 1px solid #d6b87988;
                border-radius: 50%;
                background: #121510;
                color: #e8ddc7;
                font: 7px Arial,sans-serif;
                letter-spacing: .04em
            }

            .home-languages button:hover, .home-languages button.selected {
                transform: scale(1.1);
                filter: drop-shadow(0 0 7px #d6b879)
            }

                .home-languages button.selected span {
                    background: var(--gold);
                    color: #171711
                }

    .home-hero {
        --sh: max(480px,calc(100vh - 78px));
        --w: min(max(100vw,calc(var(--sh)*1.3334)),calc(var(--sh)*2.08));
        --h: calc(var(--w)*.75);
        position: relative;
        isolation: isolate;
        overflow: hidden;
        width: 100%;
        height: var(--sh);
        margin: 0;
        border-bottom: 1px solid var(--line);
        background: #0a0d0b
    }

        .home-hero::before {
            content: "";
            position: absolute;
            inset: -40px;
            z-index: -3;
            background: url('/images/heritage/home-hero.webp') center/cover no-repeat;
            filter: blur(24px) brightness(.55)
        }

    .hero-canvas {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        width: var(--w);
        height: var(--h);
        top: clamp(calc(var(--sh) - var(--h)),calc(var(--sh)/2 - .45*var(--h)),0px)
    }

    .hero-art {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        z-index: 0;
        animation: hero-appear 1.1s ease both
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background: radial-gradient(ellipse 19% 24% at 9% 8%,rgba(6,8,7,.7),transparent 100%)
    }

    .hero-editorial {
        position: absolute;
        left: 2.5%;
        top: 3.5%;
        width: min(250px,17%);
        z-index: 2;
        animation: copy-appear .85s .12s both
    }

    .eyebrow, .section-kicker {
        font: 8px Arial,sans-serif;
        letter-spacing: .25em;
        text-transform: uppercase;
        color: var(--gold)
    }

    .eyebrow {
        display: flex;
        align-items: center;
        gap: 11px
    }

    .eyebrow-line {
        width: 26px;
        height: 1px;
        background: var(--gold)
    }

    .hero-editorial h1 {
        margin: 10px 0 8px;
        color: #f3e8cf;
        font-size: clamp(1.5rem,2.6vw,2.8rem);
        font-weight: 400;
        line-height: .94;
        letter-spacing: .035em;
        text-shadow: 0 3px 28px #000
    }

    .hero-subtitle {
        margin: 0;
        color: #e6d7b6;
        font: 9px/1.8 Arial,sans-serif;
        letter-spacing: .26em;
        text-transform: uppercase
    }

        .hero-subtitle strong {
            font-weight: 400;
            color: #f1e9d9
        }

    .hero-intro {
        max-width: 230px;
        margin: 12px 0 14px;
        color: #c7c2b6;
        font: 10px/1.65 Arial,sans-serif;
        letter-spacing: .015em
    }

    .heritage-pillars {
        display: flex;
        gap: 15px;
        margin: 21px 0 24px
    }

        .heritage-pillars a {
            min-width: 58px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 7px;
            color: #d8d0be;
            text-decoration: none;
            text-transform: uppercase;
            font: 7px Arial,sans-serif;
            letter-spacing: .11em
        }

            .heritage-pillars a:hover {
                color: var(--bright)
            }

    .pillar-icon {
        width: 29px;
        height: 29px;
        display: grid;
        place-items: center;
        border: 1px solid #d6b87999;
        border-radius: 50%;
        color: var(--gold);
        font-size: 15px
    }

    .heritage-cta {
        width: max-content;
        min-width: 195px;
        height: 43px;
        padding: 0 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 22px;
        border: 1px solid var(--gold);
        color: var(--bright);
        text-decoration: none;
        text-transform: uppercase;
        font: 8px Arial,sans-serif;
        letter-spacing: .14em;
        transition: .2s
    }

        .heritage-cta:hover {
            background: var(--gold);
            color: #11130e;
            box-shadow: 0 0 24px #d6b87933
        }

        .heritage-cta b {
            font-size: 16px;
            font-weight: 400
        }

    .hero-hotspot {
        position: absolute;
        z-index: 3;
        border-radius: 10px;
        display: flex;
        align-items: flex-start;
        justify-content: flex-end;
        border: 1px solid transparent;
        text-decoration: none;
        cursor: pointer;
        transition: background .18s,border-color .18s,box-shadow .18s
    }

        .hero-hotspot:hover, .hero-hotspot:focus-visible {
            border-color: #e5c77b;
            background: rgba(213,181,116,.09);
            box-shadow: inset 0 0 22px rgba(213,181,116,.18),0 0 24px rgba(213,181,116,.5);
            transform: scale(1.015);
            outline: none
        }

    .hotspot-arrow {
        width: 20px;
        height: 20px;
        margin: 4px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(230,202,131,.85);
        border-radius: 50%;
        background: rgba(11,13,11,.78);
        color: #f2d68d;
        font: 12px Arial,sans-serif;
        opacity: .7
    }

    .hero-hotspot-label {
        position: absolute;
        left: 50%;
        bottom: calc(100% + 6px);
        transform: translate(-50%,5px);
        white-space: nowrap;
        padding: 5px 9px;
        background: rgba(9,12,10,.88);
        border: 1px solid rgba(213,181,116,.55);
        color: #f5e5bd;
        text-align: center;
        font: 11px/1.2 Arial,sans-serif;
        opacity: 0;
        transition: opacity .18s,transform .18s;
        pointer-events: none
    }

    .hero-hotspot:hover .hero-hotspot-label, .hero-hotspot:focus-visible .hero-hotspot-label {
        opacity: 1;
        transform: translate(-50%,0)
    }

    .scroll-hint {
        display: block;
        margin-top: 23px;
        color: #aba697;
        font: 7px Arial,sans-serif;
        letter-spacing: .2em;
        text-transform: uppercase
    }

    .scene-label {
        position: absolute;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 8px 11px;
        border: 1px solid #d6b87988;
        border-radius: 22px;
        background: #10130fc9;
        backdrop-filter: blur(8px);
        color: #f0e4c7;
        font: 9px Georgia,serif;
        box-shadow: 0 5px 20px #0008
    }

        .scene-label span {
            width: 19px;
            height: 19px;
            display: grid;
            place-items: center;
            border: 1px solid var(--gold);
            border-radius: 50%;
            color: var(--gold);
            font-size: 12px
        }

        .scene-label small {
            display: block;
            color: #d8bd7d;
            font: 7px Arial,sans-serif;
            letter-spacing: .09em
        }

    .scene-label-map {
        right: 34%;
        top: 25%
    }

    .scene-label-music {
        right: 16%;
        top: 19%
    }

    .scene-label-craft {
        right: 11%;
        top: 44%
    }

    .pin-glow:after {
        content: "";
        display: block;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #ffda8b;
        box-shadow: 0 0 10px #ffda8b
    }

    .hero-map-card {
        position: absolute;
        right: clamp(24px,5vw,78px);
        bottom: 30px;
        width: min(295px,28%);
        display: grid;
        grid-template-columns: 94px 1fr;
        gap: 12px;
        padding: 9px;
        border: 1px solid #d6b8797d;
        background: rgba(10,13,10,.86);
        backdrop-filter: blur(10px);
        color: var(--paper);
        text-decoration: none;
        box-shadow: 0 14px 35px #000a;
        transition: transform .2s,border-color .2s
    }

        .hero-map-card:hover {
            transform: translateY(-3px);
            border-color: var(--gold);
            color: white
        }

    .map-card-image {
        height: 82px;
        overflow: hidden
    }

        .map-card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: saturate(.7)
        }

    .map-card-copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 6px
    }

        .map-card-copy small {
            color: var(--gold);
            font: 6px Arial,sans-serif;
            letter-spacing: .18em
        }

        .map-card-copy strong {
            font: 13px Georgia,serif;
            font-weight: 400;
            line-height: 1.25
        }

        .map-card-copy span {
            color: #c7bdab;
            font: 6px Arial,sans-serif;
            letter-spacing: .08em
        }

        .map-card-copy b {
            float: right;
            color: var(--gold);
            font-size: 11px;
            font-weight: 400
        }

    .hero-coordinate {
        position: absolute;
        left: clamp(24px,5vw,78px);
        bottom: 20px;
        color: #d3c9b5;
        font: 7px Arial,sans-serif;
        letter-spacing: .19em
    }

        .hero-coordinate span {
            color: var(--gold);
            padding: 0 7px
        }

    .home-collection {
        max-width: 1580px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.12fr repeat(3,minmax(130px,.72fr)) 1.18fr;
        gap: 11px;
        padding: 21px 0 23px;
        align-items: stretch
    }

    .collection-intro {
        padding: 9px 17px 6px 4px
    }

        .collection-intro h2 {
            margin: 9px 0;
            color: #eee2c8;
            font: 25px/1.1 Georgia,serif;
            font-weight: 400
        }

        .collection-intro p {
            max-width: 280px;
            margin: 0;
            color: #aaa89e;
            font: 10px/1.7 Arial,sans-serif
        }

        .collection-intro > a {
            display: inline-block;
            margin-top: 12px;
            color: var(--gold);
            text-decoration: none;
            font: 7px Arial,sans-serif;
            letter-spacing: .1em;
            text-transform: uppercase
        }

            .collection-intro > a b {
                margin-left: 9px;
                font-size: 12px;
                font-weight: 400
            }

    .collection-card {
        height: 142px;
        position: relative;
        overflow: hidden;
        border: 1px solid var(--line);
        color: #f5ead2;
        text-decoration: none;
        background: #161913
    }

        .collection-card > img, .living-landscape > img {
            width: 100%;
            height: 100%;
            position: absolute;
            inset: 0;
            object-fit: cover;
            transition: transform .4s,filter .4s;
            filter: saturate(.72)
        }

        .collection-card:hover > img, .living-landscape:hover > img {
            transform: scale(1.05);
            filter: saturate(1)
        }

    .collection-card-shade {
        position: absolute;
        inset: 0;
        background: linear-gradient(0deg,#090b09e8,transparent 75%)
    }

    .collection-card-copy {
        position: absolute;
        inset: auto 13px 11px;
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: end;
        gap: 5px
    }

        .collection-card-copy small {
            grid-column: 1/-1;
            color: #e0c98f;
            font: 6px Arial,sans-serif;
            letter-spacing: .15em
        }

        .collection-card-copy strong {
            font: 14px Georgia,serif;
            font-weight: 400
        }

        .collection-card-copy b {
            color: var(--gold);
            font: 14px Arial,sans-serif;
            font-weight: 400
        }

    .living-landscape {
        height: 142px;
        position: relative;
        overflow: hidden;
        border: 1px solid var(--line);
        color: #f1e7d4;
        text-decoration: none
    }

        .living-landscape:after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg,#0b0e0ce8,transparent 100%)
        }

        .living-landscape > span {
            position: absolute;
            z-index: 1;
            inset: 19px 15px;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 7px
        }

        .living-landscape small {
            color: var(--gold);
            font: 6px Arial,sans-serif;
            letter-spacing: .16em;
            text-transform: uppercase
        }

        .living-landscape strong {
            font: 20px Georgia,serif;
            font-weight: 400
        }

        .living-landscape b {
            margin-top: auto;
            color: #e4d5b2;
            font: 6px Arial,sans-serif;
            letter-spacing: .12em;
            font-weight: 400
        }

    .home-footer {
        padding: 0 clamp(18px,4.2vw,70px);
        max-width: none;
        height: 42px;
        margin: auto;
        border-top: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: #88877f;
        font: 7px Arial,sans-serif;
        letter-spacing: .16em
    }

        .home-footer b {
            color: var(--gold)
        }

        .home-footer a {
            color: #c8bdab;
            text-decoration: none
        }

            .home-footer a:hover {
                color: var(--gold)
            }

    @@keyframes hero-appear {
        from {
            opacity: .45;
            transform: scale(1.025)
        }

        to {
            opacity: .92;
            transform: scale(1)
        }
    }

    @@keyframes copy-appear {
        from {
            opacity: 0;
            translate: 0 12px
        }

        to {
            opacity: 1;
            translate: 0 0
        }
    }

    @@media(max-width:1120px) {
        .hero-editorial {
            width: 24%
        }
    }

    @@media(max-width:760px) {
        .hero-hotspot-label {
            display: none
        }

        .hero-hotspot {
            border-radius: 5px
        }

        .home-picker-space {
            width: 96px
        }

        .heritage-home {
            padding: 0
        }

        .home-header {
            height: 68px;
            gap: 10px;
            padding: 0 16px
        }

        .brand-sun {
            width: 32px;
            height: 32px;
            font-size: 23px
        }

        .brand-type {
            font-size: 8px
        }

            .brand-type small {
                font-size: 6px
            }

        .home-nav {
            gap: 11px
        }

            .home-nav a {
                font-size: 6px;
                letter-spacing: .08em
            }

                .home-nav a:nth-child(3), .home-nav a:nth-child(5) {
                    display: none
                }

        .home-languages {
            gap: 3px
        }

            .home-languages button {
                width: 30px;
                height: 30px
            }

                .home-languages button span {
                    width: 21px;
                    height: 21px;
                    font-size: 6px
                }

        .home-hero {
            height: auto;
            min-height: 0;
            aspect-ratio: 2304/1728
        }

        .hero-art {
            object-position: 58% center
        }

        .hero-overlay {
            background: linear-gradient(90deg,rgba(8,10,8,.6),transparent 42%),linear-gradient(0deg,rgba(8,10,8,.25),transparent 35%)
        }

        .hero-editorial {
            left: 10px;
            top: auto;
            bottom: 10px;
            width: min(145px,37%);
            padding: 8px;
            background: rgba(9,12,10,.78);
            border: 1px solid rgba(213,181,116,.35);
            transform: none
        }

            .hero-editorial h1 {
                font-size: clamp(1.35rem,7vw,2rem);
                margin: 6px 0
            }

            .hero-editorial .eyebrow, .hero-subtitle, .hero-intro, .heritage-cta, .scroll-hint {
                font-size: 6px
            }

        .hero-intro {
            line-height: 1.4;
            margin: 5px 0
        }

        .heritage-cta {
            min-width: 0;
            height: 29px;
            padding: 0 7px;
            gap: 5px
        }

        .hero-intro {
            font-size: 11px
        }

