@page "/"
@using System.Globalization
@inject Digital_Heritage.Data.SiteLanguageService Languages
@implements IDisposable

<PageTitle>@Languages.Text("home.title") · Digital Heritage</PageTitle>

<div class="heritage-home">
    <header class="home-header">
        <a class="home-brand" href="/" aria-label="Digital Heritage home">
            <span class="brand-sun" aria-hidden="true">✺</span>
            <span class="brand-type">DIGITAL HERITAGE<small>KURDISTAN · CULTURAL ATLAS</small></span>
        </a>
        <nav class="home-nav" aria-label="Main navigation">
            <a class="current" href="/">@Languages.Text("nav.home")</a>
            <a href="/map">@Languages.Text("nav.map")</a>
            <a href="/gallery">@Languages.Text("nav.gallery")</a>
            <a href="/culture/newroz">@Languages.Text("nav.stories")</a>
            <a href="/traditions">@Pick("Bräuche", "Traditions", "نەریتەکان")</a>
            <a href="/culture/kobani">@Pick("Kobanê", "Kobanî", "کۆبانی")</a>
            <a href="/about">@Pick("Über mich", "About me", "دەربارەی من")</a>
        </nav>
    </header>

    <main>
        <section class="home-hero" aria-label="Kurdistans kulturelles Erbe">
            <div class="hero-canvas">
                <img class="hero-art" src="/images/heritage/home-hero.webp" alt="Kurdistan cultural atlas: a woman in traditional Kurdish dress facing a glowing screen of cultural heritage topics in a mountain landscape." />
                @foreach (var tile in Tiles)
                {
                    <a class="hero-hotspot" style="@Pos(tile)" href="@tile.Href" aria-label="@tile.Label" title="@tile.Label">
                        <span class="hotspot-arrow" aria-hidden="true">↗</span>
                        <span class="hero-hotspot-label">@tile.Label</span>
                    </a>
                }

                <div class="hero-live-copy">
                    <p class="hero-live-eyebrow">TRADITION · MENSCHEN · REGIONEN</p>
                    <h1 class="hero-live-title">@Pick("Kurdistans kulturelles Erbe", "Kurdistan’s cultural heritage", "کەلەپووری کوردستان")<br /><em>@Pick("digital entdecken", "discover digitally", "بە دیجیتاڵی بدۆزەرەوە")</em></h1>
                    <p class="hero-live-description">@Pick("Eine interaktive Reise durch Geschichte, Traditionen, Kunst und die vielfältigen Regionen Kurdistans.", "An interactive journey through Kurdistan’s history, traditions, art and diverse regions.", "گەشتێکی کارلێکەر بۆ مێژوو، نەریت، هونەر و ناوچە جیاوازەکانی کوردستان.")</p>
                    <div class="hero-live-actions"><a class="hero-live-cta" href="/map">@Languages.Text("home.explore") <span aria-hidden="true">↗</span></a></div>
                </div>
            </div>
        </section>

        <section class="home-history" aria-labelledby="home-history-title">
            <div class="history-emblem" aria-hidden="true">✺</div>
            <div class="history-heading">
                <span class="section-kicker">@Languages.Text("home.history")</span>
                <h1 id="home-history-title">@Languages.Text("home.historyTitle")</h1>
            </div>
            <div class="history-copy">
                <p>@Languages.Text("home.historyText")</p>
                <p class="history-today">@Languages.Text("home.today")</p>
                <a href="https://www.cambridge.org/core/books/abs/kurds/from-rebellion-to-political-manifestos-kurdish-nationalism-in-twentiethcentury-iran-and-iraq/F75A900BB2D44EE088AEB5D956183FC6" target="_blank" rel="noopener noreferrer">@Languages.Text("home.historySource") ↗</a>
            </div>
        </section>
    </main>

    <footer class="home-footer">
        <span>© 2026 DIGITAL HERITAGE · KURDISTAN</span>
        <span>PLACE <b>·</b> VOICE <b>·</b> MEMORY</span>
        <a href="/map">@Languages.Text("nav.map") ↗</a>
    </footer>
</div>

<style>
    .page:has(.heritage-home) {
        min-height: 100vh;
    }

        .page:has(.heritage-home) .sidebar {
            display: none;
        }

        .page:has(.heritage-home) main {
            min-height: 100vh;
            overflow: visible;
        }

        .page:has(.heritage-home) .content {
            padding: 0 !important;
        }

    .heritage-home {
        --gold: #d6b879;
        --bright: #f3d99a;
        --paper: #f1eee5;
        --muted: #aaa79e;
        --line: rgba(230,211,169,.2);
        min-height: 100vh;
        overflow: hidden;
        color: var(--paper);
        background: #07121a;
        font-family: Georgia,"Times New Roman",serif;
    }

    .home-header {
        min-height: 78px;
        padding: 0 clamp(16px,4.2vw,70px);
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        border-bottom: 1px solid var(--line);
        position: relative;
        z-index: 5;
        background: #06131eeF;
        font-family: Arial,sans-serif;
    }

    .home-brand {
        display: flex;
        align-items: center;
        gap: 13px;
        color: var(--paper);
        text-decoration: none;
        white-space: nowrap;
    }

    .brand-sun {
        width: 39px;
        height: 39px;
        display: grid;
        place-items: center;
        border: 1px solid var(--gold);
        border-radius: 50%;
        color: var(--gold);
        font-size: 28px;
    }

    .brand-type {
        font-size: clamp(9px,.9vw,14px);
        letter-spacing: .19em;
        font-weight: 600;
    }

        .brand-type small {
            display: block;
            margin-top: 5px;
            color: #bdb7a7;
            font-size: 7px;
            letter-spacing: .23em;
            font-weight: 400;
        }

    .home-nav {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: clamp(10px,1.8vw,28px);
    }

        .home-nav a {
            position: relative;
            color: #e3dfd5;
            text-decoration: none;
            font: clamp(8px,.78vw,12px) Arial,sans-serif;
            white-space: nowrap;
        }

            .home-nav a:hover, .home-nav a.current {
                color: var(--bright);
            }

                .home-nav a.current:after {
                    content: "";
                    position: absolute;
                    left: 0;
                    right: 0;
                    bottom: -10px;
                    height: 2px;
                    background: var(--gold);
                }

    .home-hero {
        position: relative;
        width: 100%;
        margin: 0;
        overflow: hidden;
        background: #08131a;
    }

    .hero-canvas {
        position: relative;
        width: 100%;
        aspect-ratio: 1672 / 941;
        overflow: hidden;
    }

    .hero-art {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: fill;
        z-index: 0;
    }

    .hero-hotspot {
        position: absolute;
        z-index: 2;
        box-sizing: border-box;
        display: flex;
        align-items: flex-start;
        justify-content: flex-end;
        border: 1px solid transparent;
        border-radius: 7px;
        text-decoration: none;
        transition: background .18s,border-color .18s,box-shadow .18s;
    }

        .hero-hotspot:hover, .hero-hotspot:focus-visible {
            border-color: #f3d48b;
            background: rgba(213,181,116,.13);
            box-shadow: inset 0 0 18px #d6b87935,0 0 18px #e5bf6b88;
            outline: 2px solid transparent;
        }

    .hotspot-arrow {
        display: grid;
        place-items: center;
        width: clamp(14px,1.5vw,23px);
        height: clamp(14px,1.5vw,23px);
        margin: 3px;
        border: 1px solid #e5c77b;
        border-radius: 50%;
        color: #f5d88f;
        background: #07131bd9;
        font: clamp(9px,.8vw,13px) Arial,sans-serif;
        opacity: 0;
    }

    .hero-hotspot:hover .hotspot-arrow, .hero-hotspot:focus-visible .hotspot-arrow {
        opacity: 1;
    }

    .hero-hotspot-label {
        position: absolute;
        left: 50%;
        bottom: calc(100% + 5px);
        transform: translate(-50%,4px);
        padding: 5px 8px;
        color: #f5e5bd;
        background: #09131eee;
        border: 1px solid #d5b57488;
        font: 11px Arial,sans-serif;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
    }

    .hero-hotspot:hover .hero-hotspot-label, .hero-hotspot:focus-visible .hero-hotspot-label {
        opacity: 1;
        transform: translate(-50%,0);
    }

    .home-history {
        display: grid;
        grid-template-columns: 72px minmax(240px,1fr) minmax(280px,1.25fr) auto;
        gap: 28px;
        align-items: center;
        padding: 34px clamp(22px,9.5vw,160px);
        border-top: 1px solid #d6b87955;
        border-bottom: 1px solid var(--line);
        background: radial-gradient(ellipse at 30% 0,#12252b,#071115 68%);
    }

    .history-emblem {
        display: grid;
        place-items: center;
        width: 62px;
        height: 62px;
        border: 1px solid var(--gold);
        color: var(--gold);
        font-size: 39px;
    }

    .section-kicker {
        color: var(--gold);
        font: 10px Arial,sans-serif;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

    .history-heading {
        border-left: 1px solid #d6b87966;
        padding-left: 26px;
    }

        .history-heading h1 {
            margin: 9px 0 0;
            color: #f0e5ce;
            font: clamp(22px,2vw,31px)/1.16 Georgia,serif;
            font-weight: 400;
        }

    .history-copy p {
        margin: 0 0 8px;
        color: #d2d4d0;
        font: 13px/1.7 Arial,sans-serif;
    }

    .history-copy .history-today {
        color: #e8d8b5;
    }

    .history-copy a, .history-more {
        color: var(--bright);
        font: 11px Arial,sans-serif;
    }

    .history-copy a {
        text-decoration: none;
    }

    .history-more {
        display: flex;
        align-items: center;
        gap: 12px;
        white-space: nowrap;
        text-decoration: none;
        border-bottom: 1px solid var(--gold);
        padding-bottom: 5px;
    }

        .history-more span {
            font-size: 18px;
        }

    .home-footer {
        min-height: 44px;
        padding: 0 clamp(16px,4.2vw,70px);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        color: #9c9b92;
        font: 8px Arial,sans-serif;
        letter-spacing: .13em;
    }

        .home-footer b {
            color: var(--gold);
        }

        .home-footer a {
            color: #d8c9aa;
            text-decoration: none;
        }

    @@media(max - width:1000px) {
        .home-header {
            align-items: flex-start;
            flex-direction: column;
            justify-content: center;
            gap: 12px;
            padding-top: 14px;
            padding-bottom: 14px;
        }

        .home-nav {
            justify-content: flex-start;
            gap: 14px;
        }

            .home-nav a.current:after {
                bottom: -5px;
            }

        .home-history {
            grid-template-columns: 52px 1fr;
            gap: 18px;
            padding: 26px 5%;
        }

        .history-emblem {
            width: 48px;
            height: 48px;
            font-size: 30px;
        }

        .history-heading {
            padding-left: 18px;
        }

        .history-copy {
            grid-column: 2;
        }

        .history-more {
            grid-column: 2;
            width: max-content;
        }
    }
    @@media(max - width:600px) {
        .home-header {
            min-height: 0;
        }

        .brand-sun {
            width: 31px;
            height: 31px;
            font-size: 22px;
        }

        .brand-type {
            font-size: 9px;
        }

            .brand-type small {
                font-size: 6px;
            }

        .home-nav {
            gap: 12px;
        }

            .home-nav a {
                font-size: 9px;
            }

                .home-nav a:nth-child(n+5) {
                    display: none;
                }

        .hero-canvas {
            aspect-ratio: 1672 / 941;
        }

        .hero-hotspot {
            border-radius: 3px;
        }

        .hero-hotspot-label {
            display: none;
        }

        .hotspot-arrow {
            opacity: 0;
        }

        .hero-cta-hotspot {
            left: 5%;
            top: 62%;
            width: 18%;
            height: 11%;
        }

        .home-history {
            grid-template-columns: 38px 1fr;
            gap: 13px;
            padding: 22px 16px;
        }

        .history-emblem {
            width: 36px;
            height: 36px;
            font-size: 23px;
        }

        .history-heading {
            padding-left: 12px;
        }

            .history-heading h1 {
                font-size: 21px;
            }

        .history-copy p {
            font-size: 12px;
        }

        .home-footer {
            font-size: 7px;
            letter-spacing: .05em;
        }

            .home-footer span:nth-child(2) {
                display: none;
            }
    }
    @@media(prefers - reduced - motion:reduce) {
        * {
            scroll-behavior: auto !important;
            transition: none !important;
        }
    }

    /* FIX: the floating language picker belongs to the header's right edge,
           not on top of the navigation. Scoped to the homepage only. */
    .page:has(.heritage-home) > main {
        width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
        min-width: 0;
    }

        .page:has(.heritage-home) > main > .top-row {
            display: none !important;
        }

        .page:has(.heritage-home) > main > .content {
            padding: 0 !important;
            margin: 0 !important;
            width: 100%;
            max-width: none;
        }

    .heritage-home > main {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        min-height: 0 !important;
    }

    .heritage-home .home-header {
        box-sizing: border-box;
        display: grid;
        grid-template-columns: minmax(220px, 1fr) auto minmax(210px, 1fr);
        align-items: center;
        gap: 18px;
        padding: 0 28px;
        min-height: 88px;
    }

    .heritage-home .home-brand {
        grid-column: 1;
        justify-self: start;
    }

    .heritage-home .home-nav {
        grid-column: 2;
        display: flex;
        flex-wrap: nowrap;
        justify-content: center;
        align-items: center;
        gap: clamp(10px,1.35vw,24px);
    }

        .heritage-home .home-nav a {
            font-size: clamp(10px,.86vw,13px);
        }

    .page:has(.heritage-home) .site-language-picker.floating {
        position: absolute !important;
        top: 19px !important;
        right: 24px !important;
        left: auto !important;
        z-index: 30;
        padding: 4px 6px !important;
        background: rgba(5,17,27,.65) !important;
        box-shadow: none !important;
        border: 1px solid rgba(214,184,121,.22) !important;
        border-radius: 10px !important;
    }

        .page:has(.heritage-home) .site-language-picker.floating .language-buttons-row {
            display: flex;
            gap: 3px;
        }

        .page:has(.heritage-home) .site-language-picker.floating button {
            width: 31px;
            height: 31px;
            font-size: 11px;
        }

            .page:has(.heritage-home) .site-language-picker.floating button span {
                width: 25px;
                height: 25px;
            }

        .page:has(.heritage-home) .site-language-picker.floating .floating-brand {
            display: none;
        }
    /* Precise clickable hit areas are mapped to the same 1672:941 image coordinate system. */
    .heritage-home .hero-canvas {
        aspect-ratio: 1672 / 941;
    }

    .heritage-home .hero-art {
        object-fit: contain;
    }

    .heritage-home .hero-hotspot {
        cursor: pointer;
    }
    @@media (max-width:1180px) {
        .heritage-home .home-header {
            grid-template-columns: 1fr;
            gap: 12px;
            padding: 15px 18px 13px;
            align-items: start;
        }

        .heritage-home .home-brand, .heritage-home .home-nav {
            grid-column: 1;
        }

        .heritage-home .home-nav {
            justify-content: flex-start;
            flex-wrap: wrap;
            padding-right: 0;
            max-width: 100%;
        }

        .heritage-home .home-brand {
            padding-right: 140px;
        }

        .page:has(.heritage-home) .site-language-picker.floating {
            top: 15px !important;
            right: 12px !important;
        }
    }
    @@media (max-width:600px) {
        .heritage-home .home-nav {
            gap: 10px;
        }

            .heritage-home .home-nav a {
                font-size: 10px;
            }

                .heritage-home .home-nav a:nth-child(n+5) {
                    display: inline;
                }

        .heritage-home .home-brand {
            padding-right: 132px;
        }

        .page:has(.heritage-home) .site-language-picker.floating {
            top: 9px !important;
            right: 7px !important;
        }
    }

    /* Editable, selectable, animated text over the left part of the cinematic image. */
    .heritage-home .hero-live-copy {
        position: absolute;
        z-index: 4;
        left: 0;
        top: 0;
        bottom: 0;
        width: 35%;
        box-sizing: border-box;
        padding: clamp(18px,3.7vw,62px) clamp(16px,3.9vw,66px);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        background: none;
        pointer-events: none;
    }

    .heritage-home .hero-live-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        pointer-events: auto;
    }

    .heritage-home .hero-live-eyebrow {
        color: #e6cf9b;
        font: 600 clamp(8px,.7vw,12px) Arial,sans-serif;
        letter-spacing: .18em;
        margin: 0 0 clamp(12px,1.5vw,25px);
    }

    .heritage-home .hero-live-title {
        color: #fff5e5;
        font: 600 clamp(23px,3.1vw,55px)/1.07 Georgia,serif;
        margin: 0;
        max-width: 580px;
        text-wrap: balance;
    }

        .heritage-home .hero-live-title em {
            display: inline-block;
            color: #f4c77d;
            font-weight: 400;
            margin-top: 5px;
        }

    .heritage-home .hero-live-description {
        color: #f1ece2;
        font: clamp(11px,1.1vw,18px)/1.55 Arial,sans-serif;
        max-width: 360px;
        margin: clamp(13px,1.8vw,29px) 0;
    }

    .heritage-home .hero-live-cta {
        pointer-events: auto;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 22px;
        padding: clamp(8px,.9vw,14px) clamp(13px,1.6vw,26px);
        border: 1px solid #edca81;
        border-radius: 50px;
        color: #fff0d0;
        text-decoration: none;
        background: #0b1a23e8;
        box-shadow: 0 0 13px #e1b75a66;
        font: clamp(11px,.9vw,15px) Arial,sans-serif;
    }

        .heritage-home .hero-live-cta:hover, .heritage-home .hero-live-cta:focus-visible {
            background: #d6b879;
            color: #06131e;
            outline: 2px solid #f3d99a;
            outline-offset: 3px;
        }
    @@media(max - width:760px) {
        .heritage-home .hero-live-copy {
            width: 39%;
            padding: 12px 10px;
        }

        .heritage-home .hero-live-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            pointer-events: auto;
        }

        .heritage-home .hero-live-eyebrow {
            font-size: 7px;
            margin-bottom: 6px;
        }

        .heritage-home .hero-live-title {
            font-size: clamp(12px,3.1vw,23px);
        }

        .heritage-home .hero-live-description {
            font-size: clamp(8px,1.6vw,11px);
            margin: 7px 0;
            line-height: 1.25;
        }

        .heritage-home .hero-live-cta {
            padding: 5px 9px;
            gap: 6px;
            font-size: 9px;
        }
    }
    @@media(prefers - reduced - motion:no - preference) {
        .heritage-home .hero-live-title {
            animation: heroTextReveal .85s ease-out both;
        }

            .heritage-home .hero-live-title em {
                overflow: hidden;
                display: block;
                width: max-content;
                max-width: 100%;
                white-space: nowrap;
                clip-path: inset(0 100% 0 0);
                animation: heroType 2.6s steps(24,end) .75s forwards;
            }
        @@keyframes heroType {
            to {
                clip-path: inset(0 0 0 0);
            }
        }

        .heritage-home .hero-live-description {
            animation: heroTextReveal .85s ease-out .22s both;
        }

        .heritage-home .hero-live-actions {
            animation: heroTextReveal .75s ease-out .4s both;
        }
        @@keyframes heroTextReveal {
            from {
                opacity: 0;
                transform: translateY(12px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }
    }
</style>

@code {
    private record Tile(string Href, double Left, double Top, double Width, double Height, string Label);

    // Click areas are percentages of the new hero image (1672 x 941).
    private IEnumerable<Tile> Tiles => new[]
    {
        new Tile("/culture/deq", 46.4, 22.0, 8.4, 17.8, Languages.Text("nav.deq")),
        new Tile("/culture/dance", 56.3, 22.0, 8.6, 17.8, Languages.Text("nav.dance")),
        new Tile("/culture/wedding-fruit", 66.3, 22.0, 8.6, 17.8, Pick("Tracht & Hochzeit", "Costume & wedding", "جلوبەرگ و هاوسەرگیری")),
        new Tile("/crafts", 76.2, 22.0, 10.0, 17.8, Languages.Text("nav.crafts")),
        new Tile("/culture/jin-jiyan-azadi", 46.4, 39.0, 8.4, 17.5, Languages.Text("nav.jin")),
        new Tile("/Küche", 56.3, 39.0, 8.6, 17.5, Pick("Küche & Brot", "Food & bread", "خواردن و نان")),
        new Tile("/culture/clove-apple", 66.3, 39.0, 8.6, 17.5, Languages.Text("nav.cloveApple")),
        new Tile("/culture/newroz", 76.2, 39.0, 10.0, 17.5, Languages.Text("nav.newroz")),
        new Tile("/culture/kobani", 46.4, 56.1, 8.4, 17.5, Pick("Geschichte & Kobanê", "History & Kobanî", "مێژوو و کۆبانی")),
        new Tile("/map", 56.3, 56.1, 8.6, 17.5, Languages.Text("nav.map")),
        new Tile("/music", 66.3, 56.1, 8.6, 17.5, Pick("Tanbur & Dengbêj", "Tanbur & Dengbêj", "تەنبوور و دەنگبێژ")),
        new Tile("/culture/kurdish-sun", 76.2, 56.1, 10.0, 17.5, Languages.Text("nav.sun")),
    };

    private string Pos(Tile t) => string.Create(CultureInfo.InvariantCulture,
        $"left:{t.Left}%;top:{t.Top}%;width:{t.Width}%;height:{t.Height}%");

    private string Pick(string de, string en, string ku) =>
        Languages.CurrentLanguage == "de" ? de : Languages.CurrentLanguage == "ku" ? ku : en;

    protected override void OnInitialized() => Languages.Changed += HandleLanguageChanged;
    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Languages.Changed -= HandleLanguageChanged;
}
