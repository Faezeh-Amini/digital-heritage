@code
{

    private bool loaded = false;



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (firstRender && !loaded)
        {

            loaded = true;
            try
            {
                var savedLanguage = await JS.InvokeAsync<string?>("siteLanguage.get");
                if (SiteLanguageService.IsSupported(savedLanguage))
                {
                    Languages.SetLanguage(savedLanguage!);
                    await JS.InvokeVoidAsync("siteLanguage.apply", savedLanguage);
                }
            }
            catch (InvalidOperationException) { }


            Console.WriteLine("BLAZOR CALLING CESIUM");


            await JS.InvokeVoidAsync(
                "initCesiumMap",
                "cesium-container"
            );


            Console.WriteLine("CESIUM CALLED");


        }

    }


    protected override void OnInitialized() => Languages.Changed += HandleLanguageChanged;
    private void HandleLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Languages.Changed -= HandleLanguageChanged;
    private async Task ChangeLanguageAsync(string language)
    {
        Languages.SetLanguage(language);
        try { await JS.InvokeVoidAsync("siteLanguage.apply", language); } catch (InvalidOperationException) { }
    }
}










