@layout MapLayout
@page "/map"

@using Microsoft.AspNetCore.Components.Web

@using Microsoft.JSInterop

@inject IJSRuntime JS
@inject SiteLanguageService Languages
@implements IDisposable


<PageTitle>
    @Languages.Text("map.title")
</PageTitle>



<div class="map-page">


    <div id="cesium-container"></div>



    <div class="map-title">


        <h1>
            @Languages.Text("map.title")
        </h1>


        <p>
            @Languages.Text("map.subtitle")
        </p>
        <div class="region-legend" aria-label="Approximate cultural regions">
            <span class="legend-title">@Languages.Text("map.legend")</span>
            <span><i class="legend-bakur"></i>Bakûr</span><span><i class="legend-rojava"></i>Rojava</span>
            <span><i class="legend-bashur"></i>Bashûr</span><span><i class="legend-rojhilat"></i>Rojhilat</span>
        </div>


    </div>



    <div class="map-culture-tools">
        <nav class="map-story-links" aria-label="Main navigation">
            <a href="/">@Languages.Text("nav.home")</a><a href="/map">@Languages.Text("nav.map")</a><a href="/gallery">@Languages.Text("nav.gallery")</a><a href="/culture/newroz">@Languages.Text("nav.newroz")</a><a href="/culture/dengbej">@Languages.Text("nav.dengbej")</a><a href="/culture/jin-jiyan-azadi">@Languages.Text("nav.jin")</a><a href="/culture/dance">@Languages.Text("nav.dance")</a><a href="/culture/deq">@Languages.Text("nav.deq")</a>
        </nav>
        <SiteLanguagePicker Variant="map" />
    </div>
    <aside class="city-picker" aria-label="Cities on the cultural map">
        <div class="city-picker-heading"><div><span class="city-picker-kicker">KURDISTAN · CULTURAL ATLAS</span><h2 id="city-list-title">Cities</h2></div><span class="city-count" id="city-count">32</span></div>
        <label class="city-search-label" for="city-search">Find a city</label>
        <input id="city-search" class="city-search" type="search" placeholder="Search cities…" autocomplete="off" />
        <div class="city-list" id="city-list"></div>
    </aside>    <div id="heritage-panel">
</div>


</div>






<style>


    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }



    .map-page {
