@page "/culture/kobani"
@inject Digital_Heritage.Data.SiteLanguageService Languages
@implements IDisposable

<PageTitle>@T("title") · Digital Heritage</PageTitle>
<main class="kobani-page">
    <a class="kobani-back" href="/">⌂ @T("back")</a>
    <nav class="kobani-nav" aria-label="@T("navLabel")"><a href="/traditions">@T("traditions")</a><a href="/culture/jin-jiyan-azadi">@T("jin")</a><a href="/crafts">@T("clothing")</a><a class="active" href="/culture/kobani">@T("title")</a></nav>
    <section class="kobani-hero"><a href="/images/heritage/kobani.jfif" target="_blank" rel="noopener noreferrer"><img src="/images/heritage/kobani.jfif" alt="@T("heroAlt")" /></a><div><span>@T("kicker")</span><h1>@T("title")</h1><p>@T("intro")</p></div></section>
    <article class="kobani-story"><h2>@T("memoryTitle")</h2><p>@T("memory")</p><div class="kobani-themes"><section><b>01</b><h3>@T("womenTitle")</h3><p>@T("women")</p></section><section><b>02</b><h3>@T("communityTitle")</h3><p>@T("community")</p></section><section><b>03</b><h3>@T("costTitle")</h3><p>@T("cost")</p></section></div><p class="kobani-note">@T("caution")</p><p class="kobani-source">@T("sourceLabel") <a href="https://digitallibrary.un.org/record/789117/files/A_HRC_28_69-AR.pdf" target="_blank" rel="noopener noreferrer">@T("sourceOne")</a> · <a href="https://arabstates.unwomen.org/sites/default/files/Field%20Office%20Arab%20States/Attachments/Publications/Lahoud-Fin-Web-rev.pdf" target="_blank" rel="noopener noreferrer">@T("sourceTwo")</a></p></article>
    <section class="kobani-gallery"><h2>@T("gallery")</h2><p>@T("galleryHint")</p><div class="kobani-photos">@foreach(var photo in Photos){<figure><a href="@photo.Path" target="_blank" rel="noopener noreferrer"><img src="@photo.Path" alt="@T(photo.Alt)" loading="lazy" /></a><figcaption>@T(photo.Caption)</figcaption></figure>}</div></section>
</main>
<style>
.kobani-page{max-width:1320px;margin:auto;padding:1rem clamp(1rem,4vw,3.5rem) 4rem;color:#f0ece2}.kobani-back,.kobani-nav a{color:#efd89c;text-decoration:none}.kobani-back{display:inline-block;margin-bottom:1rem;padding:.65rem .9rem;border:1px solid #d5b57455;background:#151914;font:12px Arial,sans-serif}.kobani-nav{display:flex;gap:8px;overflow-x:auto;padding:5px 0 18px}.kobani-nav a{flex:0 0 auto;padding:9px 12px;border:1px solid #d5b57444;background:#151914;font:11px Arial,sans-serif;white-space:nowrap}.kobani-nav a:hover,.kobani-nav a.active{background:#d5b574;color:#151914}.kobani-hero{display:grid;grid-template-columns:1.1fr .9fr;min-height:370px;border:1px solid #d5b57444;background:#151914}.kobani-hero>a{display:block;min-height:370px;overflow:hidden}.kobani-hero img{width:100%;height:100%;min-height:370px;object-fit:cover}.kobani-hero>div{align-self:center;padding:clamp(1.5rem,4vw,3.5rem)}.kobani-hero span{color:#d5b574;font:9px Arial,sans-serif;letter-spacing:.2em}.kobani-hero h1,.kobani-story h2,.kobani-gallery h2{color:#f4e8c5;font:400 clamp(2rem,4vw,3.3rem) Georgia,serif}.kobani-hero p,.kobani-story p,.kobani-themes p,.kobani-gallery>p{color:#d4d0c5;font:14px/1.9 Arial,sans-serif}.kobani-story{max-width:1000px;margin:2.5rem auto}.kobani-story h2,.kobani-gallery h2{font-size:clamp(1.5rem,3vw,2.2rem)}.kobani-themes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px;margin:1.7rem 0}.kobani-themes section{padding:1.2rem;border:1px solid #d5b57444;background:#151914}.kobani-themes b{color:#d5b574;font:11px Arial,sans-serif;letter-spacing:.14em}.kobani-themes h3{color:#f3e5c2;font:400 1.1rem Georgia,serif}.kobani-themes p{font-size:13px}.kobani-note{padding:1rem 1.2rem;border-left:2px solid #d5b574;background:#ffffff08;color:#efdfb8!important}.kobani-source{font-size:12px!important;color:#aaa99f!important}.kobani-source a{color:#e6ca83}.kobani-gallery{margin-top:3rem}.kobani-gallery>p{color:#aaa99f}.kobani-photos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.kobani-photos figure{margin:0;border:1px solid #d5b57444;background:#151914}.kobani-photos a{display:block;height:260px}.kobani-photos img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s}.kobani-photos a:hover img{transform:scale(1.04)}.kobani-photos figcaption{padding:12px;color:#e8d9b5;font:12px/1.6 Arial,sans-serif}
@@media(max-width:760px){.kobani-hero{grid-template-columns:1fr}.kobani-hero>a,.kobani-hero img{min-height:270px;height:270px}.kobani-hero>div{padding:1.5rem}.kobani-themes{grid-template-columns:1fr}.kobani-photos{grid-template-columns:repeat(2,minmax(0,1fr))}}
@@media(max-width:480px){.kobani-photos{grid-template-columns:1fr}.kobani-photos a{height:240px}}
</style>
@code {
    private string Lang => Languages.CurrentLanguage;
    private string T(string key) => (Lang,key) switch
    {
        ("de","title")=>"Kobanê · Erinnerung und Frauen",("de","back")=>"Startseite",("de","navLabel")=>"Kulturelle Geschichten",("de","traditions")=>"Kurdische Bräuche",("de","jin")=>"Jin, Jiyan, Azadî",("de","clothing")=>"Kleidung und Handwerk",("de","kicker")=>"KULTURELLES GEDÄCHTNIS · GEGENWART",("de","heroAlt")=>"Kobanê und sein kulturelles Gedächtnis",("de","intro")=>"Die Ereignisse in Kobanê 2014–2015 wurden für viele Menschen zu einem international wahrgenommenen Zeichen des Widerstands gegen den sogenannten Islamischen Staat. In kurdischen Erzählungen ist die Stadt zugleich mit Verlust, Schutz des eigenen Zuhauses und gesellschaftlichem Zusammenhalt verbunden.",("de","memoryTitle")=>"Eine Stadt, mehrere Erinnerungen",("de","memory")=>"Kobanê ist nicht nur mit einem militärischen Konflikt verbunden. Für viele steht die Stadt auch für die Erfahrungen der Zivilbevölkerung, Vertreibung und Rückkehr sowie für internationale Aufmerksamkeit auf kurdische Gemeinschaften.",("de","womenTitle")=>"Frauen in der Geschichte",("de","women")=>"Frauen waren in unterschiedlichen Rollen an der Verteidigung und am gesellschaftlichen Leben beteiligt. Bilder kurdischer Kämpferinnen aus Kobanê prägten die internationale visuelle Erinnerung an die Ereignisse; sie sind jedoch nur ein Teil der vielfältigen Erfahrungen von Frauen.",("de","communityTitle")=>"Zusammenhalt und Zuhause",("de","community")=>"In kulturellen Erzählungen werden Kobanê und seine Umgebung mit Schutz der Gemeinschaft, gegenseitiger Unterstützung und der Bindung an Heimat verbunden.",("de","costTitle")=>"Die menschlichen Folgen",("de","cost")=>"Der Konflikt brachte zivile Opfer, Flucht und Zerstörung mit sich. Eine Kulturerzählung sollte neben Widerstand auch den Preis des Krieges und die Erfahrungen der Zivilbevölkerung sichtbar machen.",("de","caution")=>"Die Bedeutung Kobanês ist nicht für alle Menschen gleich. Diese Seite beschreibt eine Perspektive des kulturellen Gedächtnisses und setzt keine einheitliche politische Haltung voraus.",("de","sourceLabel")=>"Hintergrundquellen:",("de","sourceOne")=>"UN-Untersuchungskommission · Bericht zu Syrien",("de","sourceTwo")=>"UN Women · Frauen und visuelle Erinnerung",("de","gallery")=>"Kobanê in Bildern",("de","galleryHint")=>"Bild anklicken, um es in voller Größe zu öffnen.",("de","alt1")=>"Ansicht von Kobanê",("de","alt2")=>"Kobanê und die umgebende Landschaft",("de","alt3")=>"Erinnerungsbild zu Kobanê",("de","cap1")=>"Kobanê",("de","cap2")=>"Stadt und Landschaft",("de","cap3")=>"Erinnerung und Gegenwart",
        ("ku","title")=>"کۆبانی · بیرەوەری و ژنان",("ku","back")=>"پەڕەی سەرەکی",("ku","navLabel")=>"چیرۆکە کولتوورییەکان",("ku","traditions")=>"نەریتە کوردییەکان",("ku","jin")=>"ژن، ژیان، ئازادی",("ku","clothing")=>"جل‌وبەرگ و دەستکاری",("ku","kicker")=>"بیرەوەریی کولتووری · سەردەم",("ku","heroAlt")=>"کۆبانی و بیرەوەریی کولتووریی ئەو",("ku","intro")=>"ڕووداوەکانی کۆبانی لە ٢٠١٤–٢٠١٥ بۆ زۆر کەس بوون بە هێمایەکی جیهانیی بەرخودان لە دژی دەوڵەتی ئیسلامی. لە گێڕانەوە کوردییەکاندا شارەکە هەروەها بە لەدەستدان، پاراستنی ماڵ و خاک و یەکگرتوویی کۆمەڵایەتییەوە پەیوەستە.",("ku","memoryTitle")=>"شارێک، چەند بیرەوەرییەک",("ku","memory")=>"کۆبانی تەنها بە ملمڵانێیەکی سەربازییەوە پەیوەست نییە. بۆ زۆر کەس ئەم شارە هەروەها بیرەوەریی دانیشتووانی مەدەنی، ئاوارەبوون و گەڕانەوە، و سەرنجی جیهانی بۆ کۆمەڵگە کوردییەکان دەگەیەنێت.",("ku","womenTitle")=>"ژنان لە مێژووی هاوچەرخدا",("ku","women")=>"ژنان بە ڕۆڵی جیاواز لە بەرگری و ژیانی کۆمەڵایەتیدا بەشدار بوون. وێنەی ژنانی پێشمەرگە لە کۆبانی کاریگەرییان لەسەر بیرەوەریی بینراوی جیهانی دانا؛ بەڵام تەنها بەشێکن لە ئەزموونی جۆراوجۆری ژنان.",("ku","communityTitle")=>"یەکگرتوویی و ماڵ",("ku","community")=>"لە گێڕانەوە کولتوورییەکاندا کۆبانی و دەوروبەری بە پاراستنی کۆمەڵگە، یارمەتیی یەکتر و پەیوەندی بە ماڵ و خاکەوە دەبەسترێنەوە.",("ku","costTitle")=>"کاریگەریی مرۆیی",("ku","cost")=>"ململانێکەکە بووە هۆی زیانی مەدەنی، ئاوارەبوون و وێرانی. چیرۆکێکی کولتووری دەبێت لەگەڵ بەرخودان، نرخ و ئەزموونی دانیشتووانی مەدەنییش پیشان بدات.",("ku","caution")=>"واتای کۆبانی بۆ هەموو کەسێک یەکسان نییە. ئەم پەڕەیە ڕوانگەیەک لە بیرەوەریی کولتووری باس دەکات و بانگەشەی یەکگرتوویی هەموو دیدگا سیاسییەکان ناکات.",("ku","sourceLabel")=>"سەرچاوەی زانیاری:",("ku","sourceOne")=>"کۆمسیۆنی لێکۆڵینەوەی نەتەوە یەکگرتووەکان · سوریە",("ku","sourceTwo")=>"UN Women · ژنان و بیرەوەریی بینراو",("ku","gallery")=>"کۆبانی بە وێنە",("ku","galleryHint")=>"کلیک لە وێنە بکە بۆ کردنەوەی بە قەبارەی تەواو.",("ku","alt1")=>"دیمەنی کۆبانی",("ku","alt2")=>"کۆبانی و دیمەنی دەوروبەر",("ku","alt3")=>"وێنەیەک لە بیرەوەریی کۆبانی",("ku","cap1")=>"کۆبانی",("ku","cap2")=>"شار و دیمەن",("ku","cap3")=>"بیرەوەری و سەردەم",
        (_,"title")=>"Kobanî · memory and women",(_,"back")=>"Home",(_,"navLabel")=>"Cultural stories",(_,"traditions")=>"Kurdish traditions",(_,"jin")=>"Jin, Jiyan, Azadî",(_,"clothing")=>"Clothing and crafts",(_,"kicker")=>"CULTURAL MEMORY · CONTEMPORARY",(_,"heroAlt")=>"Kobanî and its cultural memory",(_,"intro")=>"The events in Kobanî in 2014–2015 became, for many people, an internationally recognized symbol of resistance to the so-called Islamic State. Kurdish narratives also connect the city with loss, protecting home, and social solidarity.",(_,"memoryTitle")=>"One city, many memories",(_,"memory")=>"Kobanî is remembered in more than the context of armed conflict. For many, it also evokes civilian experience, displacement and return, and global attention to Kurdish communities.",(_,"womenTitle")=>"Women in contemporary history",(_,"women")=>"Women took part in defense and community life in different roles. Images of Kurdish women fighters from Kobanî shaped international visual memory of the events, but represent only part of women's diverse experiences.",(_,"communityTitle")=>"Solidarity and home",(_,"community")=>"Cultural narratives connect Kobanî and its surroundings with protecting the community, mutual support and attachment to home.",(_,"costTitle")=>"The human cost",(_,"cost")=>"The conflict brought civilian casualties, displacement and destruction. A cultural account should remember resistance alongside the cost of war and civilian experiences.",(_,"caution")=>"Kobanî does not mean the same thing to everyone. This page presents one perspective in cultural memory and does not assume a single political position.",(_,"sourceLabel")=>"Background sources:",(_,"sourceOne")=>"UN Commission of Inquiry · Syria report",(_,"sourceTwo")=>"UN Women · women and visual memory",(_,"gallery")=>"Kobanî in photographs",(_,"galleryHint")=>"Select a photograph to open it at full size.",(_,"alt1")=>"View of Kobanî",(_,"alt2")=>"Kobanî and its surrounding landscape",(_,"alt3")=>"A photograph connected with Kobanî's memory",(_,"cap1")=>"Kobanî",(_,"cap2")=>"City and landscape",(_,"cap3")=>"Memory and the present",_=>key
    };
    private IReadOnlyList<Photo> Photos => new[] { new Photo("/images/heritage/kobani.jfif","alt1","cap1"),new Photo("/images/heritage/kobani1.jfif","alt2","cap2"),new Photo("/images/heritage/kobani3.jfif","alt3","cap3") };
    protected override void OnInitialized()=>Languages.Changed+=OnLanguageChanged;
    private void OnLanguageChanged()=>_ = InvokeAsync(StateHasChanged);
    public void Dispose()=>Languages.Changed-=OnLanguageChanged;
    private sealed record Photo(string Path,string Alt,string Caption);
}
