@page "/traditions"
@page "/culture/wedding-fruit"
@page "/culture/pomegranate-festival"
@inject Digital_Heritage.Data.SiteLanguageService Languages
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@T("pageTitle") · Digital Heritage</PageTitle>
<main class="traditions-page">
    <a class="traditions-back" href="/">⌂ @T("back")</a>
    <nav class="traditions-nav" aria-label="@T("sectionTitle")">
        <a class="@(IsHub ? "active" : "")" href="/traditions">@T("sectionTitle")</a>
        <a href="/culture/newroz">@T("newroz")</a><a href="/culture/pir-shalyar">@T("pir")</a>
        <a class="@(IsWedding ? "active" : "")" href="/culture/wedding-fruit">@T("wedding")</a>
        <a class="@(IsFestival ? "active" : "")" href="/culture/pomegranate-festival">@T("festival")</a>
        <a href="/culture/clove-apple">@T("clove")</a>
    </nav>
    @if (IsHub)
    {
        <header class="traditions-heading"><span>@T("kicker")</span><h1>@T("sectionTitle")</h1><p>@T("intro")</p></header>
        <section class="tradition-cards" aria-label="@T("sectionTitle")">
            @foreach (var card in Cards)
            {
                <a class="tradition-card" href="@card.Href"><img src="@card.Image" alt="@T(card.Alt)" loading="lazy" /><span class="tradition-shade"></span><span class="tradition-card-copy"><small>@T("kicker")</small><strong>@T(card.Title)</strong><span>@T(card.Summary)　↗</span></span></a>
            }
        </section>
    }
    else
    {
        <section class="tradition-hero">
            <a class="tradition-cover" href="@HeroImage" target="_blank" rel="noopener noreferrer"><img src="@HeroImage" alt="@T("heroAlt")" /></a>
            <div><span class="tradition-kicker">@T("kicker")</span><h1>@T(IsWedding ? "weddingTitle" : "festivalTitle")</h1><p>@T(IsWedding ? "weddingIntro" : "festivalIntro")</p></div>
        </section>
        <article class="tradition-story">
            <h2>@T(IsWedding ? "weddingMeaningTitle" : "festivalMeaningTitle")</h2>
            <p>@T(IsWedding ? "weddingMeaning" : "festivalMeaning")</p>
            <h2>@T(IsWedding ? "practiceTitle" : "harvestTitle")</h2>
            <p>@T(IsWedding ? "weddingPractice" : "festivalPractice")</p>
            <p class="tradition-note">@T("caution")</p>
        </article>
        @if (IsWedding)
        {
            <section class="tradition-video-section"><h2>@(Lang == "de" ? "Hochzeitsvideos" : Lang == "ku" ? "ڤیدیۆی ئاهەنگی هاوسەرگیری" : "Wedding videos")</h2><div class="tradition-videos">
                <article><video controls preload="metadata" poster="/images/heritage/zamawan%28hafla%29/zamawan%20%28hafla%29kurdistan.jpg"><source src="/images/heritage/zamawan%28hafla%29/zamawan...mp4" type="video/mp4" /></video><h3>@(Lang == "de" ? "Kurdische Hochzeitsfeier · 1" : Lang == "ku" ? "ئاهەنگی هاوسەرگیریی کوردی · ١" : "Kurdish wedding celebration · 1")</h3></article>
                <article><video controls preload="metadata" poster="/images/heritage/zamawan%28hafla%29/zamawan%20%28hafla%29kurdistan.jpg"><source src="/images/heritage/zamawan%28hafla%29/zamawan.mp4" type="video/mp4" /></video><h3>@(Lang == "de" ? "Kurdische Hochzeitsfeier · 2" : Lang == "ku" ? "ئاهەنگی هاوسەرگیریی کوردی · ٢" : "Kurdish wedding celebration · 2")</h3></article>
                <article><video controls preload="metadata" poster="/images/heritage/zamawan%28hafla%29/zamawan%20%28hafla%29kurdistan.jpg"><source src="/images/heritage/zamawan%28hafla%29/zamawan2.mp4" type="video/mp4" /></video><h3>@(Lang == "de" ? "Kurdische Hochzeitsfeier · 3" : Lang == "ku" ? "ئاهەنگی هاوسەرگیریی کوردی · ٣" : "Kurdish wedding celebration · 3")</h3></article>
            </div></section>
        }
        <section class="tradition-gallery"><h2>@T("gallery")</h2><p>@T("galleryHint")</p><div class="tradition-photos">
            @foreach (var photo in DetailPhotos)
            {
                <figure><a href="@photo.Path" target="_blank" rel="noopener noreferrer"><img src="@photo.Path" alt="@T(photo.Alt)" loading="lazy" /></a><figcaption>@T(photo.Caption)</figcaption></figure>
            }
        </div></section>
    }
</main>
<style>
.traditions-page{max-width:1320px;margin:auto;padding:1rem clamp(1rem,4vw,3.5rem) 4rem;color:#f0ece2}.traditions-back{display:inline-block;margin:0 0 1rem;padding:.65rem .9rem;color:#efd89c;border:1px solid #d5b57455;background:#151914;text-decoration:none;font:12px Arial,sans-serif}.traditions-nav{display:flex;gap:8px;overflow-x:auto;padding:5px 0 18px}.traditions-nav a{flex:0 0 auto;padding:9px 12px;border:1px solid #d5b57444;background:#151914;color:#efd89c;text-decoration:none;font:11px Arial,sans-serif;white-space:nowrap}.traditions-nav a:hover,.traditions-nav a.active{background:#d5b574;color:#151914}.traditions-heading{text-align:center;max-width:760px;margin:3rem auto 2rem}.traditions-heading>span,.tradition-kicker,.tradition-card-copy small{color:#d5b574;font:9px Arial,sans-serif;letter-spacing:.2em;text-transform:uppercase}.traditions-heading h1,.tradition-hero h1{margin:.8rem 0;color:#f4e8c5;font:400 clamp(2rem,4vw,3.4rem) Georgia,serif}.traditions-heading p,.tradition-hero p,.tradition-story p,.tradition-gallery>p{color:#d4d0c5;font:14px/1.9 Arial,sans-serif}.tradition-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.tradition-card{min-height:270px;position:relative;overflow:hidden;border:1px solid #d5b57444;color:#f1eee5;text-decoration:none;background:#151914}.tradition-card>img{position:absolute;width:100%;height:100%;inset:0;object-fit:cover;transition:transform .35s}.tradition-card:hover>img{transform:scale(1.04)}.tradition-shade{position:absolute;inset:0;background:linear-gradient(0deg,#080a08ef,transparent 75%)}.tradition-card-copy{position:absolute;inset:auto 16px 16px;display:grid;gap:7px}.tradition-card-copy strong{color:#f4e8c5;font:400 1.35rem Georgia,serif}.tradition-card-copy>span{color:#ddd4c1;font:12px/1.6 Arial,sans-serif}.tradition-hero{display:grid;grid-template-columns:1.1fr .9fr;min-height:370px;border:1px solid #d5b57444;background:#151914}.tradition-cover{display:block;min-height:370px;overflow:hidden}.tradition-cover img{width:100%;height:100%;min-height:370px;object-fit:cover}.tradition-hero>div{align-self:center;padding:clamp(1.5rem,4vw,3.5rem)}.tradition-hero p{margin:0}.tradition-story{max-width:900px;margin:2.5rem auto}.tradition-story h2,.tradition-gallery h2{margin:2rem 0 .75rem;color:#f3e5c2;font:400 clamp(1.5rem,3vw,2.2rem) Georgia,serif}.tradition-story p{margin:.5rem 0 1rem}.tradition-note{padding:1rem 1.2rem;border-left:2px solid #d5b574;background:#ffffff08;color:#efdfb8!important}.tradition-video-section{margin:3rem auto}.tradition-video-section h2{margin:0 0 .8rem;color:#f3e5c2;font:400 clamp(1.5rem,3vw,2.2rem) Georgia,serif}.tradition-videos{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.tradition-videos article{padding:10px;border:1px solid #d5b57444;background:#151914}.tradition-videos video{display:block;width:100%;max-height:420px;background:#080a08}.tradition-videos h3{margin:10px 2px 2px;color:#e8d9b5;font:13px Arial,sans-serif}.tradition-gallery{margin-top:3rem}.tradition-gallery>p{color:#aaa99f}.tradition-photos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.tradition-photos figure{margin:0;border:1px solid #d5b57444;background:#151914}.tradition-photos a{display:block;height:260px}.tradition-photos img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s}.tradition-photos a:hover img{transform:scale(1.04)}.tradition-photos figcaption{padding:12px;color:#e8d9b5;font:12px/1.6 Arial,sans-serif}
@@media(max-width:760px){.tradition-cards{grid-template-columns:repeat(2,minmax(0,1fr))}.tradition-hero{grid-template-columns:1fr}.tradition-cover,.tradition-cover img{min-height:270px;height:270px}.tradition-hero>div{padding:1.5rem}.tradition-photos{grid-template-columns:repeat(2,minmax(0,1fr))}}
@@media(max-width:480px){.tradition-cards,.tradition-photos,.tradition-videos{grid-template-columns:1fr}.tradition-card{min-height:240px}.tradition-photos a{height:240px}}
</style>
@code {
    private string Route => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', 2)[0].Trim('/').ToLowerInvariant();
    private bool IsHub => Route == "traditions";
    private bool IsWedding => Route == "culture/wedding-fruit";
    private bool IsFestival => Route == "culture/pomegranate-festival";
    private string HeroImage => IsWedding ? "/images/heritage/zamawan%28hafla%29/zamawan%20%28hafla%29kurdistan.jpg" : "/images/heritage/jazhn%20hanar/jazhn%20hanar.jfif";
    private string Lang => Languages.CurrentLanguage;
    private string T(string key) => (Lang, key) switch
    {
        ("de", "back") => "Startseite", ("de", "sectionTitle") => "Kurdische Bräuche", ("de", "pageTitle") => IsWedding ? "Hochzeitsbräuche" : IsFestival ? "Granatapfelfest" : "Kurdische Bräuche", ("de", "kicker") => "LEBENDIGES KURDISCHES KULTURERBE", ("de", "intro") => "Entdecke Feste und Bräuche, in denen Erinnerung, Jahreszeiten, Musik und gemeinschaftliches Leben zusammenkommen.", ("de", "newroz") => "Newroz", ("de", "pir") => "Pîr Şalyar", ("de", "wedding") => "Hochzeitsbräuche", ("de", "festival") => "Granatapfelfest", ("de", "clove") => "Nelkenapfel", ("de", "weddingTitle") => "Apfel und Granatapfel bei kurdischen Hochzeiten", ("de", "weddingIntro") => "In einigen kurdischen Hochzeitsbräuchen, darunter Überlieferungen aus den kurmandschsprachigen Gemeinden Nord-Chorassans, werden Äpfel und Granatäpfel mit guten Wünschen für das Paar verbunden.", ("de", "weddingMeaningTitle") => "Liebe, Segen und gute Wünsche", ("de", "weddingMeaning") => "Der Granatapfel kann wegen seiner vielen Kerne für Fülle und Segen stehen; der Apfel wird in manchen volkstümlichen Deutungen mit Schönheit, Liebe und einem glücklichen Leben verbunden. Solche Bedeutungen sind lokale Interpretationen.", ("de", "practiceTitle") => "Ein regionaler Hochzeitsbrauch", ("de", "weddingPractice") => "In einigen Erzählungen wirft der Bräutigam beim Empfang der Braut Früchte unter die Gäste. Musik, Gesang und Gruppentanz können die Feier begleiten; Ablauf und Bedeutung unterscheiden sich nach Ort und Familie.", ("de", "festivalTitle") => "Granatapfel- und Herbstfeste", ("de", "festivalIntro") => "Die Granatapfelernte wird in Teilen Kurdistans mit lokalen Märkten und Kulturveranstaltungen begangen. Besonders bekannt ist das jährliche Granatapfelfest in Halabja.", ("de", "festivalMeaningTitle") => "Ernte, Landschaft und Gemeinschaft", ("de", "festivalMeaning") => "Granatapfelfeste machen die Verbindung zwischen Landwirtschaft, saisonalen Produkten und kulturellem Leben sichtbar. Musik, lokale Erzeugnisse und Kunsthandwerk können Teil des Programms sein.", ("de", "harvestTitle") => "Halabja und Hawraman", ("de", "festivalPractice") => "In Halabja findet ein jährliches Granatapfel- und Herbstfest statt. In Hawraman und benachbarten Gebieten zeigen lokale Ernteveranstaltungen und Bilder ebenfalls die Bedeutung des Granatapfels für die regionale Gartenbaukultur.", ("de", "caution") => "Bräuche und Symboldeutungen sind regional verschieden. Die Bilder zeigen kulturelle Veranstaltungen, aber nicht zwangsläufig genau den beschriebenen Hochzeitsmoment.", ("de", "heroAlt") => IsWedding ? "Kurdische Hochzeitsfeier" : "Granatäpfel bei einer kurdischen Herbstveranstaltung", ("de", "gallery") => "Bildergalerie", ("de", "galleryHint") => "Bild anklicken, um es in voller Größe zu öffnen.", ("de", "cardWedding") => "Apfel und Granatapfel bei Hochzeiten", ("de", "summaryWedding") => "Ein regionaler Brauch mit guten Wünschen für das Paar.", ("de", "cardFestival") => "Granatapfel- und Herbstfeste", ("de", "summaryFestival") => "Ernte, lokale Produkte und kulturelle Begegnungen.", ("de", "cardPir") => "Pîr Şalyar", ("de", "summaryPir") => "Eine winterliche Zeremonie in Hawraman.", ("de", "cardNewroz") => "Newroz", ("de", "summaryNewroz") => "Frühling, Feuer und gemeinschaftliche Erinnerung.", ("de", "cardClove") => "Der Nelkenapfel", ("de", "summaryClove") => "Ein handgefertigtes Zeichen von Erinnerung und Zuneigung.", ("de", "altWedding") => "Kurdische Hochzeitsfeier", ("de", "altFestival") => "Granatäpfel bei einem lokalen Fest", ("de", "captionWedding") => "Hochzeitsfeier in einer kurdischen Gemeinschaft", ("de", "caption1") => "Granatäpfel bei einem Erntefest", ("de", "caption2") => "Einblick in die lokale Veranstaltung", ("de", "caption3") => "Traditionelle Kleidung und Feststimmung", ("de", "caption4") => "Granatapfelstand beim Festival", ("de", "caption5") => "Herbstliche Festdekoration",
