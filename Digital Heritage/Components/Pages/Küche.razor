    private record RegionDish(
    string Name,
    string De,
    string En,
    string Link,
    string Ku = ""
);

    private record Region(
        string File,
        string Tag,
        string NameDe,
        string NameEn,
        string StaplesDe,
        string StaplesEn,
        RegionDish[] Dishes,
        string NameKu = "",
        string StaplesKu = ""
    );

    private record Item(
        string File,
        string TitleDe,
        string TitleEn,
        string TextDe,
        string TextEn,
        string Link,
        string LinkLabel,
        string Category = "main",
        string TitleKu = "",
        string TextKu = ""
   
    );

    private static string Img(string file)
        => "/images/heritage/Food/" + Uri.EscapeDataString(file);

    private string L(string de, string en, string ku = "")
    {
        return Languages.CurrentLanguage switch
        {
            "de" => de,
            "en" => en,
            "ku" => !string.IsNullOrWhiteSpace(ku)
                ? ku
                : KurdishTranslations.GetValueOrDefault(de, de),
            _ => de
        };
    }

    // ---- Links: Wikipedia-Seiten, die es wirklich gibt ----
    private const string WikiBase = "https://en.wikipedia.org/wiki/";
    private const string CuisineUrl = WikiBase + "Kurdish_cuisine";

    // Labels: Gericht hat eine eigene Seite = "Wikipedia"; sonst Übersichtsseite.
    private const string LabelWiki = "Wikipedia";
    private const string LabelCuisine = "Kurdish cuisine (Wikipedia)";

    private string SearchText = "";
    private string ActiveFilter = "all";
    private Item? SelectedItem;
    private IJSObjectReference? _foodModule;

    private IEnumerable<Item> FilteredDishes =>
     Dishes
         .Where(d =>
             (ActiveFilter == "all" || d.Category == ActiveFilter) &&
             (string.IsNullOrWhiteSpace(SearchText) ||
              $"{d.TitleDe} {d.TitleEn} {d.TextDe} {d.TextEn}"
                 .Contains(SearchText.Trim(),
                     StringComparison.OrdinalIgnoreCase)))
         .OrderBy(d => d.Category == "bread" ? 1 : 0);

    private string FilterClass(string filter)
        => ActiveFilter == filter
            ? "food-filter-button active"
            : "food-filter-button";

    private void SetFilter(string filter) => ActiveFilter = filter;

    private void OpenItem(Item item) => SelectedItem = item;

    private void CloseItem() => SelectedItem = null;

    private void HandleModalKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseItem();
    }

    private string CategoryLabel(Item item)
        => item.Category == "bread"
            ? L("BROT & TRADITION", "BREAD & TRADITION")
            : L("KURDISCHE KÜCHE", "KURDISH CUISINE");

