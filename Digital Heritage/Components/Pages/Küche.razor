@page "/Küche"
@page "/food"

@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Digital_Heritage.Data

@inject SiteLanguageService Languages
@inject IJSRuntime JS

@implements IAsyncDisposable

<PageTitle>@L("Kurdische Küche", "Kurdish cuisine") · Digital Heritage</PageTitle>

<div class="food-page">

    <section class="food-hero" id="food-top">
        <div class="food-hero-image" aria-hidden="true"></div>
        <div class="food-hero-shade"></div>

        <div class="food-hero-content">
            <span class="food-eyebrow">DIGITAL HERITAGE · KURDISTAN</span>

            <h1>@L("Kurdische Küche", "Kurdish cuisine")</h1>

            <p>
                @L(
                    "Eine kulinarische Reise durch Tradition, Geschmack und Gastfreundschaft.",
                    "A culinary journey through tradition, flavour and hospitality.")
            </p>

            <div class="food-button">
                @L("Kulinarische Reise starten", "Start the culinary journey")
                <span aria-hidden="true">↘</span>
            </div>

            <div class="food-hero-caption">
                <span>01 / 04</span>
                <span>
                    @L("Vier Regionen · Eine kulinarische Vielfalt",
                           "Four regions · One culinary heritage")
                </span>
            </div>
        </div>
    </section>

    <main class="food-main">

        <section class="food-intro food-reveal">
            <div>
                <span class="food-eyebrow food-eyebrow-dark">
                    @L("KULINARISCHES ERBE", "CULINARY HERITAGE")
                </span>

                <h2>@L("Mehr als ein Gericht.", "More than a dish.")</h2>
            </div>

            <p>
                @L(
                    "Die kurdische Küche ist von Bergen, Viehzucht und Landwirtschaft geprägt. Bulgur, Reis, Lamm, Joghurt und frische Kräuter gehören ebenso dazu wie das gemeinsame Essen und frisch gebackenes Brot.",
                    "Kurdish cuisine is shaped by mountains, herding and farming. Bulgur, rice, lamb, yogurt and fresh herbs are central, alongside shared meals and freshly baked bread.")
            </p>
        </section>

        <section id="food-regions" class="food-section">
            <div class="food-section-heading food-reveal">
                <span class="food-eyebrow food-eyebrow-dark">
                    01 — @L("DIE REGIONEN", "THE REGIONS")
                </span>

                <h2>@L("Vier Küchenlandschaften", "Four culinary regions")</h2>

                <p>
                    @L("Entdecke die regionalen Zutaten und Spezialitäten.",
                       "Discover regional ingredients and specialities.")
                </p>
            </div>

            <figure class="food-map food-reveal">
                <img src="@Img("kurdische food.jfif")"
                     alt="@L("Übersichtskarte der kurdischen Küche",
                                                                             "Overview map of Kurdish cuisine")"
                     loading="lazy" />
            </figure>

            <div class="food-region-grid">
                @foreach (var r in Regions)
                {
                    <article class="food-region-card food-reveal" @key="r.Tag">
                        <div class="food-region-photo">
                            <img src="@Img(r.File)"
                                 alt="@L(r.NameDe, r.NameEn)"
                                 loading="lazy" />

                            <span class="food-region-number">
                                @Array.IndexOf(Regions, r).ToString("D2")
                            </span>
                        </div>

                        <div class="food-region-content">
                            <span class="food-eyebrow food-eyebrow-dark">
                                @r.Tag
                            </span>

                            <h3>@L(r.NameDe, r.NameEn)</h3>

                            <p class="food-staples">
                                @L(r.StaplesDe, r.StaplesEn)
                            </p>

                            <div class="food-region-dishes">
                                @foreach (var d in r.Dishes)
                                {
                                    <div class="food-region-dish" @key="d.Name">
                                        <div>
                                            <strong>@d.Name</strong>
                                            <p>@L(d.De, d.En)</p>
                                        </div>

                                        <a href="@d.Link"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           aria-label="@($"More about {d.Name}")">
                                            ↗
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>

        <section id="food-dishes" class="food-section">
            <div class="food-section-heading food-reveal">
                <span class="food-eyebrow food-eyebrow-dark">
                    02 — @L("HERZHAFTE SPEISEN", "SAVOURY DISHES")
                </span>

                <h2>@L("Gerichte & Brot", "Dishes & bread")</h2>

                <p>
                    @L("Von festlichen Tafeln bis zum täglich frisch gebackenen Brot.",
                       "From festive tables to freshly baked everyday bread.")
                </p>
            </div>

            <div class="food-toolbar food-reveal">
                <label class="food-search">
                    <span aria-hidden="true">⌕</span>

                    <input type="search"
                           @bind="SearchText"
                           @bind:event="oninput"
                           placeholder="@L("Gericht suchen …", "Search dishes …")"
                           aria-label="@L("Gerichte suchen", "Search dishes")" />
                </label>

                <div class="food-filter">
                    <button type="button"
                            class="@FilterClass("all")"
                            @onclick='() => SetFilter("all")'>
                        @L("Alle", "All")
                    </button>

                    <button type="button"
                            class="@FilterClass("main")"
                            @onclick='() => SetFilter("main")'>
                        @L("Gerichte", "Dishes")
                    </button>

                    <button type="button"
                            class="@FilterClass("bread")"
                            @onclick='() => SetFilter("bread")'>
                        @L("Brot", "Bread")
                    </button>
                </div>
            </div>

            <div class="food-card-grid">
                @foreach (var d in FilteredDishes)
                {
                    <article class="food-card food-reveal" @key="d.File">
                        <button type="button"
                                class="food-card-open"
                                @onclick="() => OpenItem(d)">

                            <div class="food-card-image">
                                <img src="@Img(d.File)"
                                     alt="@L(d.TitleDe, d.TitleEn)"
                                     loading="lazy" />

                                <span class="food-card-arrow">↗</span>
                            </div>

                            <div class="food-card-body">
                                <span class="food-card-kicker">
                                    @CategoryLabel(d)
                                </span>

                                <h3>@L(d.TitleDe, d.TitleEn, d.TitleKu)</h3>
                                <p>@L(d.TextDe, d.TextEn, d.TextKu)</p>
                               

                                <span class="food-card-more">
                                    @L("Geschichte entdecken", "Discover the story") ↗
                                </span>
                            </div>
                        </button>
                    </article>
                }
            </div>

            @if (!FilteredDishes.Any())
            {
                <p class="food-empty">
                    @L("Keine passenden Gerichte gefunden.",
                       "No matching dishes found.")
                </p>
            }
        </section>

        <section id="food-sweets" class="food-section food-sweets-section">
            <div class="food-section-heading food-reveal">
                <span class="food-eyebrow food-eyebrow-dark">
                    03 — @L("SÜSSE TRADITIONEN", "SWEET TRADITIONS")
                </span>

                <h2>
                    @L("Süßes, Gebäck & Trockenfrüchte",
                       "Sweets, pastries & dried fruit")
                </h2>

                <p>
                    @L(
                        "Zu Tee gehören Gebäck, Nüsse und Trockenfrüchte. Gastfreundschaft zeigt sich oft in einer gemeinsam geteilten Auswahl.",
                        "Tea is often served with pastries, nuts and dried fruit. Hospitality is expressed through a shared selection.")
                </p>
            </div>

            <div class="food-card-grid food-sweets-grid">
                @foreach (var d in Sweets)
                {
                    <article class="food-card food-reveal" @key="d.File">
                        <button type="button"
                                class="food-card-open"
                                @onclick="() => OpenItem(d)">

                            <div class="food-card-image">
                                <img src="@Img(d.File)"
                                     alt="@L(d.TitleDe, d.TitleEn)"
                                     loading="lazy" />

                                <span class="food-card-arrow">↗</span>
                            </div>

                            <div class="food-card-body">
                                <span class="food-card-kicker">
                                    @L("SÜSSES & GASTFREUNDSCHAFT",
                                       "SWEETS & HOSPITALITY")
                                </span>

                                <h3>@L(d.TitleDe, d.TitleEn)</h3>

                                <p>@L(d.TextDe, d.TextEn)</p>

                                <span class="food-card-more">
                                    @L("Mehr entdecken", "Discover more") ↗
                                </span>
                            </div>
                        </button>
                    </article>
                }
            </div>
        </section>

        <section class="food-closing food-reveal">
            <span class="food-eyebrow">DIGITAL HERITAGE · KURDISTAN</span>

            <h2>
                @L("Gemeinsam genießen. Tradition bewahren.",
                   "Sharing food. Preserving tradition.")
            </h2>

            <a href="/food#food-top" class="food-button food-button-light">
                @L("Zurück nach oben", "Back to top") ↑
            </a>
        </section>

    </main>
</div>

@if (SelectedItem is not null)
{
    <div class="food-modal-backdrop"
         @onclick="CloseItem"
         @onkeydown="HandleModalKey"
         tabindex="0"
         role="presentation">

        <section class="food-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-label="@L(SelectedItem.TitleDe, SelectedItem.TitleEn)"
                 @onclick:stopPropagation="true">

            <button type="button"
                    class="food-modal-close"
                    aria-label="@L("Schließen", "Close")"
                    @onclick="CloseItem">
                ×
            </button>

            <img class="food-modal-image"
                 src="@Img(SelectedItem.File)"
                 alt="@L(SelectedItem.TitleDe, SelectedItem.TitleEn)" />

            <div class="food-modal-content">
                <span class="food-eyebrow food-eyebrow-dark">
                    @L("KULINARISCHES ERBE", "CULINARY HERITAGE")
                </span>

                <h2>@L(SelectedItem.TitleDe, SelectedItem.TitleEn)</h2>

                <p>@L(SelectedItem.TextDe, SelectedItem.TextEn)</p>

                @if (!string.IsNullOrWhiteSpace(SelectedItem.Link))
                {
                    <a class="food-modal-link"
                       href="@SelectedItem.Link"
                       target="_blank"
                       rel="noopener noreferrer">
                        @(string.IsNullOrWhiteSpace(SelectedItem.LinkLabel)
                            ? L("Mehr erfahren", "Learn more")
                            : SelectedItem.LinkLabel) ↗
                    </a>
                }
            </div>
        </section>
    </div>
}

<style>
    /* Die vier Regionenfotos vollständig anzeigen (kein Zuschneiden). */
    .food-region-photo {
        aspect-ratio: auto !important;
        height: auto !important;
        min-height: 0 !important;
        background: #10140f;
    }

        .food-region-photo img {
            position: static !important;
            display: block;
            width: 100%;
            height: auto !important;
            max-height: none !important;
            object-fit: contain !important;
        }
</style>

