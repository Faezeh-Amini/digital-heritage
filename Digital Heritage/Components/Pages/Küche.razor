    protected override void OnInitialized()
    {
        Languages.Changed += HandleLanguageChanged;
    }

    private void HandleLanguageChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            // Absoluter Pfad: wwwroot/js/food-page.js
            _foodModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "/js/food-page.js");

            await _foodModule.InvokeVoidAsync("initializeFoodPage");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSException ex)
        {
            // Fehlende oder fehlerhafte JS-Datei darf die Seite nicht abstürzen lassen.
            Console.WriteLine($"food-page.js konnte nicht geladen werden: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        Languages.Changed -= HandleLanguageChanged;

        if (_foodModule is not null)
        {
            try
            {
                await _foodModule.InvokeVoidAsync("disposeFoodPage");
                await _foodModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
            catch (JSException)
            {
            }
        }
    }
